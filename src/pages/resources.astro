---
import LandingLayout from '../layout/LandingLayout.astro';
import BaseHead from '../components/seo/BaseHead.astro';
import { buildWebPage } from '../components/seo/schema/webpage';
import { buildBreadcrumbs } from '../components/seo/schema/breadcrumbs';
import { SITE } from '../data/site';

const title = 'Resources & Downloads — SPMH Training & Research';
const description =
  'Internship manual, preceptor handbook, MOU template, research guidelines, and all SPMH downloads in one place.';
const path = '/resources';
const canonical = `${SITE.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPage({ title, description, path }),
    buildBreadcrumbs([
      { name: 'Home', item: `${SITE.mainSite.url}/` },
      { name: 'Training & Research', item: `${SITE.url}/` },
      { name: 'Resources', item: `${SITE.url}/resources` },
    ]),
  ],
};

const groups = [
  {
    title: 'Programme Documents',
    icon: 'graduation-cap',
    items: [
      {
        label: 'Internship Manual',
        desc: 'Full internship programme documentation.',
        href: '/files/internship-manual.pdf',
      },
      {
        label: 'Competency Frameworks',
        desc: 'Structured competency frameworks by cadre.',
        href: '/files/competency-frameworks.pdf',
      },
      {
        label: 'Student Onboarding Guide',
        desc: 'What to expect on day one.',
        href: '/files/student-onboarding.pdf',
      },
    ],
  },
  {
    title: 'Teaching & Preceptorship',
    icon: 'chalkboard-user',
    items: [
      {
        label: 'Preceptor Handbook',
        desc: 'Roles, expectations, and supervision standards.',
        href: '/files/preceptor-handbook.pdf',
      },
      {
        label: 'Faculty Exchange Guidelines',
        desc: 'Process and expectations for exchange clinicians.',
        href: '/files/faculty-exchange-guidelines.pdf',
      },
    ],
  },
  {
    title: 'Partnerships',
    icon: 'handshake',
    items: [
      {
        label: 'MOU Template',
        desc: 'Standard memorandum of understanding.',
        href: '/files/mou-template.pdf',
      },
      {
        label: 'Partnership Standards',
        desc: 'What we expect from our partners.',
        href: '/collaborate/mou',
      },
    ],
  },
  {
    title: 'Research',
    icon: 'flask-vial',
    items: [
      {
        label: 'Research Protocols & Templates',
        desc: 'Protocol formats and data collection tools.',
        href: '/files/research-protocols.pdf',
      },
      {
        label: 'Researcher Guidelines',
        desc: 'Standards and author responsibilities.',
        href: '/files/research-guidelines.pdf',
      },
      {
        label: 'Data Management Framework',
        desc: 'How data is stored and shared.',
        href: '/files/research-guidelines.pdf',
      },
    ],
  },
  {
    title: 'Accreditation',
    icon: 'clipboard-check',
    items: [
      {
        label: 'Level 5 Standards Reference',
        desc: 'MoH/KMPDC requirements as we meet them.',
        href: '/files/level-5-standards.pdf',
      },
      {
        label: 'SPMH Strategic Plan 2026–2030',
        desc: 'The full transformation roadmap.',
        href: '/level-5/roadmap',
      },
    ],
  },
];
---

<LandingLayout currentPage='Resources'>
  <BaseHead
    slot='head'
    title={title}
    description={description}
    canonical={canonical}
    jsonLd={schema}
  />

  <section class='relative bg-[#0A1730] text-white'>
    <div
      class='absolute inset-0 bg-gradient-to-br from-[#0A1730] via-[#0B1E3A] to-[#0E2549]'>
    </div>
    <div
      class='relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-20 pb-16 sm:pt-28 sm:pb-20'>
      <nav aria-label='Breadcrumb' class='mb-12'>
        <ol
          class='flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.24em] font-medium text-slate-500'>
          <li><a href='/' class='hover:text-white'>Home</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li class='text-gold'>Resources</li>
        </ol>
      </nav>
      <div
        class='grid grid-cols-1 lg:grid-cols-12 gap-y-10 lg:gap-x-10 items-end'>
        <div class='lg:col-span-7'>
          <div class='flex items-center gap-4 mb-6'>
            <span class='h-px w-12 bg-gold/70'></span>
            <span
              class='text-[10px] sm:text-xs font-semibold uppercase tracking-[0.24em] text-gold'
              >Downloads</span
            >
          </div>
          <h1
            class='font-display font-light text-white text-[2.5rem] leading-[1.02] sm:text-5xl lg:text-7xl tracking-[-0.03em] text-balance'>
            Everything in<br />
            one <em class='not-italic font-normal text-primary-light'>place</em
            >.
          </h1>
          <div class='mt-8 h-px w-16 bg-gold/80'></div>
        </div>
        <aside class='lg:col-span-5'>
          <p
            class='text-[15px] sm:text-base text-slate-300 leading-[1.75] max-w-md'>
            Programme documents, teaching resources, partnership templates,
            research guidelines, and accreditation references &mdash; all
            available as PDF downloads.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50'>
    <div class='max-w-7xl mx-auto space-y-12'>
      {
        groups.map((g) => (
          <div>
            <div class='flex items-center gap-4 mb-6'>
              <div class='w-11 h-11 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0'>
                <i class={`fas fa-${g.icon} text-base`} aria-hidden='true' />
              </div>
              <h2 class='text-2xl font-bold text-secondary'>{g.title}</h2>
            </div>
            <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5'>
              {g.items.map((item) => (
                <a
                  href={item.href}
                  download={item.href.startsWith('/files/') ? true : undefined}
                  class='group rounded-2xl border border-slate-200 bg-white p-5
                        hover:-translate-y-1 hover:shadow-lg hover:border-blue-200 transition-all'>
                  <div class='flex items-start justify-between gap-3 mb-3'>
                    <h3 class='text-sm font-bold text-secondary leading-snug'>
                      {item.label}
                    </h3>
                    <i
                      class={`text-slate-400 group-hover:text-primary transition-colors text-xs shrink-0 mt-0.5
                             ${item.href.startsWith('/files/') ? 'fas fa-download' : 'fas fa-arrow-right'}`}
                      aria-hidden='true'
                    />
                  </div>
                  <p class='text-xs text-slate-600 leading-relaxed'>
                    {item.desc}
                  </p>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</LandingLayout>
