---
import LandingLayout from '../../layout/LandingLayout.astro';
import BaseHead from '../../components/seo/BaseHead.astro';
import { buildWebPage } from '../../components/seo/schema/webpage';
import { buildBreadcrumbs } from '../../components/seo/schema/breadcrumbs';
import { SITE } from '../../data/site';

const title = '2030 Vision — Strategy & Mission | SPMH Homa Bay';
const description =
  "The 2030 vision, mission, and six strategic pillars guiding SPMH's transformation into a Level 5 teaching hospital.";
const path = '/level-5/vision';
const canonical = `${SITE.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPage({ title, description, path }),
    buildBreadcrumbs([
      { name: 'Home', item: `${SITE.mainSite.url}/` },
      { name: 'Training & Research', item: `${SITE.url}/` },
      { name: 'Level 5', item: `${SITE.url}/level-5` },
      { name: 'Vision', item: `${SITE.url}/level-5/vision` },
    ]),
  ],
};

const values = [
  {
    title: 'Professionalism',
    detail: 'Competent, ethical, patient-centred care.',
  },
  {
    title: 'Integrity & Stewardship',
    detail: 'Honesty, transparency, and prudent resource management.',
  },
  {
    title: 'Teamwork & Servant Leadership',
    detail: 'Collaboration, humility, and service.',
  },
  {
    title: 'Adaptability & Innovation',
    detail: 'Continuous learning and responsive technology.',
  },
  {
    title: 'Christ-Centered Care',
    detail: 'The love, dignity, and hope of Christ in every encounter.',
  },
];

const pillars = [
  {
    icon: 'stethoscope',
    title: 'Clinical Excellence',
    detail: 'MNCAH, emergency, surgical, inpatient, and critical care.',
  },
  {
    icon: 'users',
    title: 'Workforce Capacity',
    detail: 'Recruitment, CPD, leadership, and retention.',
  },
  {
    icon: 'network-wired',
    title: 'Infrastructure & Digital',
    detail: 'ICU/HDU, theatres, diagnostics, and EMR.',
  },
  {
    icon: 'coins',
    title: 'Financial Sustainability',
    detail: 'Costing, claims, PPP, and endowment.',
  },
  {
    icon: 'people-group',
    title: 'Community Health',
    detail: 'CHP networks, referral coordination, chronic care.',
  },
  {
    icon: 'scale-balanced',
    title: 'Governance & Ethics',
    detail: 'Board effectiveness, ethics, and partnerships.',
  },
];
---

<LandingLayout currentPage='Level 5'>
  <BaseHead
    slot='head'
    title={title}
    description={description}
    canonical={canonical}
    jsonLd={schema}
  />

  <section class='relative bg-[#0A1730] text-white'>
    <div
      class='absolute inset-0 bg-gradient-to-br from-[#0A1730] via-[#0B1E3A] to-[#0E2549]'>
    </div>
    <div
      class='relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-20 pb-16 sm:pt-28 sm:pb-20'>
      <nav aria-label='Breadcrumb' class='mb-12'>
        <ol
          class='flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.24em] font-medium text-slate-500'>
          <li><a href='/' class='hover:text-white'>Home</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li><a href='/level-5' class='hover:text-white'>Level 5</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li class='text-gold'>Vision</li>
        </ol>
      </nav>
      <div
        class='grid grid-cols-1 lg:grid-cols-12 gap-y-10 lg:gap-x-10 items-end'>
        <div class='lg:col-span-7'>
          <div class='flex items-center gap-4 mb-6'>
            <span class='h-px w-12 bg-gold/70'></span>
            <span
              class='text-[10px] sm:text-xs font-semibold uppercase tracking-[0.24em] text-gold'
              >Strategy</span
            >
          </div>
          <h1
            class='font-display font-light text-white text-[2.5rem] leading-[1.02] sm:text-5xl lg:text-7xl tracking-[-0.03em] text-balance'>
            A centre of<br />
            excellence in<br />
            <em class='not-italic font-normal text-primary-light'
              >compassionate</em
            > care.
          </h1>
          <div class='mt-8 h-px w-16 bg-gold/80'></div>
        </div>
        <aside class='lg:col-span-5'>
          <p
            class='text-[15px] sm:text-base text-slate-300 leading-[1.75] max-w-md'>
            Vision and mission of St. Paul&rsquo;s Mission Hospital as
            articulated in the Strategic Plan 2026&ndash;2030, aligned to
            Catholic Social Teaching, WHO health system principles, and
            Kenya&rsquo;s UHC agenda.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-white'>
    <div
      class='max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-y-12 lg:gap-x-16'>
      <div>
        <span class='eyebrow'>Vision</span>
        <p
          class='mt-6 font-display font-light text-2xl sm:text-3xl lg:text-4xl text-secondary leading-[1.25] text-balance'>
          A Center of Excellence in Integrated and Compassionate Healthcare.
        </p>
      </div>
      <div>
        <span class='eyebrow'>Mission</span>
        <p class='mt-6 text-lg sm:text-xl text-slate-700 leading-[1.65]'>
          To deliver high-quality, affordable, and compassionate healthcare that
          upholds human dignity and equity, while faithfully advancing the
          healing mission of Christ.
        </p>
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50'>
    <div class='max-w-7xl mx-auto'>
      <div class='max-w-3xl mb-14'>
        <span class='eyebrow'>Core Values</span>
        <h2
          class='mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-secondary text-balance'>
          Five commitments.
        </h2>
      </div>
      <ul class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5'>
        {
          values.map((v, i) => (
            <li class='rounded-2xl border border-slate-200 bg-white p-6'>
              <span class='font-mono text-xs text-slate-400'>0{i + 1}</span>
              <h3 class='mt-3 text-base font-bold text-secondary'>{v.title}</h3>
              <p class='mt-2 text-sm text-slate-600 leading-relaxed'>
                {v.detail}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-white'>
    <div class='max-w-7xl mx-auto'>
      <div class='max-w-3xl mb-14'>
        <span class='eyebrow'>Six Pillars</span>
        <h2
          class='mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-secondary text-balance'>
          The transformation architecture.
        </h2>
        <p class='mt-5 text-base sm:text-lg text-slate-600 leading-relaxed'>
          Six interdependent pillars form the strategic backbone of the pathway.
          Each one reinforces the others.
        </p>
      </div>
      <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5'>
        {
          pillars.map((p) => (
            <article class='rounded-2xl border border-slate-200 bg-white p-6 hover:border-primary/30 transition-colors'>
              <div class='w-11 h-11 rounded-lg bg-primary/10 text-primary flex items-center justify-center mb-4'>
                <i class={`fas fa-${p.icon} text-base`} aria-hidden='true' />
              </div>
              <h3 class='text-base font-bold text-secondary'>{p.title}</h3>
              <p class='mt-2 text-sm text-slate-600 leading-relaxed'>
                {p.detail}
              </p>
            </article>
          ))
        }
      </div>

      <div class='mt-14 text-center'>
        <a href='/level-5/roadmap' class='btn-primary px-6 py-3.5'>
          See the roadmap <i
            class='fas fa-arrow-right text-xs'
            aria-hidden='true'></i>
        </a>
      </div>
    </div>
  </section>
</LandingLayout>
