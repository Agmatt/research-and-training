---
import LandingLayout from '../../layout/LandingLayout.astro';
import BaseHead from '../../components/seo/BaseHead.astro';
import { buildWebPage } from '../../components/seo/schema/webpage';
import { buildBreadcrumbs } from '../../components/seo/schema/breadcrumbs';
import { SITE } from '../../data/site';

const title = 'Facilities & Infrastructure — SPMH Homa Bay';
const description =
  "Current clinical infrastructure and planned expansion at St. Paul's Mission Hospital — ICU/HDU, theatres, diagnostics, and digital systems.";
const path = '/level-5/facilities';
const canonical = `${SITE.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPage({ title, description, path }),
    buildBreadcrumbs([
      { name: 'Home', item: `${SITE.mainSite.url}/` },
      { name: 'Training & Research', item: `${SITE.url}/` },
      { name: 'Level 5', item: `${SITE.url}/level-5` },
      { name: 'Facilities', item: `${SITE.url}/level-5/facilities` },
    ]),
  ],
};

const current = [
  {
    title: 'Inpatient Wards',
    detail:
      'Male, female, paediatric, and maternity wards with a combined capacity of 52+ beds.',
  },
  {
    title: 'Theatre & Emergency',
    detail: '1–2 functional theatres plus a 24/7 emergency and casualty unit.',
  },
  {
    title: 'Maternity & Newborn',
    detail:
      'Labour and delivery rooms, maternity ward, and a newborn unit with incubators.',
  },
  {
    title: 'Diagnostics',
    detail:
      'Basic laboratory (haematology, chemistry, microbiology) and X-ray/ultrasound.',
  },
  {
    title: 'Pharmacy',
    detail: 'Inpatient and outpatient dispensing with inventory management.',
  },
  {
    title: 'Support Systems',
    detail:
      'Kitchen, laundry, stores, maintenance, water, and generator backup.',
  },
];

const planned = [
  {
    title: 'ICU & HDU',
    detail: 'Minimum 12-bed each, fully equipped for critical care.',
    phase: 'Phase 2 · 2028–2029',
  },
  {
    title: 'Theatre Expansion',
    detail:
      'From 1–2 to 7 fully equipped theatres, including maternity, ortho, ENT, dental, and ophthalmology.',
    phase: 'Phase 2 · 2028–2029',
  },
  {
    title: 'Advanced Imaging',
    detail: 'CT scanner (2027), MRI (2029), and mammography.',
    phase: 'Phased',
  },
  {
    title: 'Advanced Laboratory',
    detail:
      'PCR, viral culture, histopathology, DNA testing, and cardiac enzymes.',
    phase: 'Phase 2 · 2028–2029',
  },
  {
    title: 'Dialysis & NICU',
    detail: 'Dialysis unit and Neonatal Intensive Care Unit.',
    phase: 'Phase 2 · 2028–2029',
  },
  {
    title: '500-Bed Expansion',
    detail: 'Full structured 500-bed hospital segmented across specialties.',
    phase: 'Phased',
  },
];
---

<LandingLayout currentPage='Level 5'>
  <BaseHead
    slot='head'
    title={title}
    description={description}
    canonical={canonical}
    jsonLd={schema}
  />

  <section class='relative bg-[#0A1730] text-white'>
    <div
      class='absolute inset-0 bg-gradient-to-br from-[#0A1730] via-[#0B1E3A] to-[#0E2549]'>
    </div>
    <div
      class='relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-20 pb-16 sm:pt-28 sm:pb-20'>
      <nav aria-label='Breadcrumb' class='mb-12'>
        <ol
          class='flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.24em] font-medium text-slate-500'>
          <li><a href='/' class='hover:text-white'>Home</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li><a href='/level-5' class='hover:text-white'>Level 5</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li class='text-gold'>Facilities</li>
        </ol>
      </nav>
      <div
        class='grid grid-cols-1 lg:grid-cols-12 gap-y-10 lg:gap-x-10 items-end'>
        <div class='lg:col-span-7'>
          <div class='flex items-center gap-4 mb-6'>
            <span class='h-px w-12 bg-gold/70'></span>
            <span
              class='text-[10px] sm:text-xs font-semibold uppercase tracking-[0.24em] text-gold'
              >Infrastructure</span
            >
          </div>
          <h1
            class='font-display font-light text-white text-[2.5rem] leading-[1.02] sm:text-5xl lg:text-7xl tracking-[-0.03em] text-balance'>
            What exists.<br />
            What&rsquo;s <em class='not-italic font-normal text-primary-light'
              >coming</em
            >.
          </h1>
          <div class='mt-8 h-px w-16 bg-gold/80'></div>
        </div>
        <aside class='lg:col-span-5'>
          <p
            class='text-[15px] sm:text-base text-slate-300 leading-[1.75] max-w-md'>
            A candid view of current clinical infrastructure and the phased
            expansion required to meet Level 5 standards. No overclaiming
            &mdash; just the plan.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50'>
    <div class='max-w-7xl mx-auto'>
      <div class='max-w-3xl mb-14'>
        <span class='eyebrow'>Current Facilities</span>
        <h2
          class='mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-secondary text-balance'>
          What we have today.
        </h2>
        <p class='mt-5 text-base sm:text-lg text-slate-600 leading-relaxed'>
          A functioning Level 4 facility delivering integrated care across
          outpatient, inpatient, maternity, surgical, emergency, diagnostic, and
          pharmacy services.
        </p>
      </div>
      <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5'>
        {
          current.map((c) => (
            <article class='rounded-2xl border border-slate-200 bg-white p-6'>
              <h3 class='text-base font-bold text-secondary'>{c.title}</h3>
              <p class='mt-2 text-sm text-slate-600 leading-relaxed'>
                {c.detail}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-gray-700 text-white'>
    <div class='max-w-7xl mx-auto'>
      <div class='max-w-3xl mb-14'>
        <span class='eyebrow-light'>Planned Expansion</span>
        <h2
          class='mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-white text-balance'>
          What&rsquo;s coming.
        </h2>
        <p class='mt-5 text-base sm:text-lg text-slate-300 leading-relaxed'>
          Phased investments to close the gap against MoH Level 5 requirements.
        </p>
      </div>
      <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5'>
        {
          planned.map((p) => (
            <article class='rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur-sm p-6'>
              <span
                class='inline-flex items-center px-2.5 py-1 rounded-full bg-primary/30 text-primary-light
                         text-[10px] font-semibold uppercase tracking-wider'>
                {p.phase}
              </span>
              <h3 class='mt-4 text-base font-bold text-white'>{p.title}</h3>
              <p class='mt-2 text-sm text-slate-300 leading-relaxed'>
                {p.detail}
              </p>
            </article>
          ))
        }
      </div>
      <div class='mt-12'>
        <a
          href='/level-5/roadmap'
          class='inline-flex items-center gap-2 text-sm font-semibold text-primary-light hover:gap-3 transition-all'>
          See the full roadmap <i
            class='fas fa-arrow-right text-xs'
            aria-hidden='true'></i>
        </a>
      </div>
    </div>
  </section>
</LandingLayout>
