---
import LandingLayout from '../../layout/LandingLayout.astro';
import BaseHead from '../../components/seo/BaseHead.astro';
import { buildWebPage } from '../../components/seo/schema/webpage';
import { buildBreadcrumbs } from '../../components/seo/schema/breadcrumbs';
import { SITE } from '../../data/site';

const title = 'Impact Metrics — Level 5 Pathway Progress | SPMH';
const description =
  "Honest, phased metrics tracking SPMH's pathway toward Level 5 teaching hospital accreditation. Published openly as milestones land.";
const path = '/level-5/metrics';
const canonical = `${SITE.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPage({ title, description, path }),
    buildBreadcrumbs([
      { name: 'Home', item: `${SITE.mainSite.url}/` },
      { name: 'Training & Research', item: `${SITE.url}/` },
      { name: 'Level 5', item: `${SITE.url}/level-5` },
      { name: 'Metrics', item: `${SITE.url}/level-5/metrics` },
    ]),
  ],
};

const baselineMetrics = [
  {
    indicator: 'IPD Admissions (annual)',
    baseline: '3,699',
    target2030: '≥7,500',
    note: '2025 baseline',
  },
  {
    indicator: 'Average Bed Occupancy',
    baseline: '71%',
    target2030: '≥85%',
    note: 'Approaching saturation',
  },
  {
    indicator: 'Major Surgeries (annual)',
    baseline: '170',
    target2030: '≥800',
    note: 'Requires theatre expansion',
  },
  {
    indicator: 'Theatre Count',
    baseline: '1–2',
    target2030: '7',
    note: 'Level 5 minimum',
  },
  {
    indicator: 'ICU Beds',
    baseline: '0',
    target2030: '≥12',
    note: 'Level 5 minimum',
  },
  {
    indicator: 'HDU Beds',
    baseline: '0',
    target2030: '≥12',
    note: 'Level 5 minimum',
  },
  {
    indicator: 'EMR Coverage',
    baseline: '35%',
    target2030: '100%',
    note: 'Full hospital-wide deployment',
  },
  {
    indicator: 'Skilled Delivery Rate',
    baseline: '82%',
    target2030: '≥96%',
    note: 'MNCAH priority',
  },
];

const honestNote =
  "Metrics are published from SPMH's internal MEAL framework and the Strategic Plan 2026–2030 baseline. Targets are interim and revised annually.";
---

<LandingLayout currentPage='Level 5'>
  <BaseHead
    slot='head'
    title={title}
    description={description}
    canonical={canonical}
    jsonLd={schema}
  />

  <section class='relative bg-[#0A1730] text-white'>
    <div
      class='absolute inset-0 bg-gradient-to-br from-[#0A1730] via-[#0B1E3A] to-[#0E2549]'>
    </div>
    <div
      class='relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-20 pb-16 sm:pt-28 sm:pb-20'>
      <nav aria-label='Breadcrumb' class='mb-12'>
        <ol
          class='flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.24em] font-medium text-slate-500'>
          <li><a href='/' class='hover:text-white'>Home</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li><a href='/level-5' class='hover:text-white'>Level 5</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li class='text-gold'>Metrics</li>
        </ol>
      </nav>
      <div
        class='grid grid-cols-1 lg:grid-cols-12 gap-y-10 lg:gap-x-10 items-end'>
        <div class='lg:col-span-7'>
          <div class='flex items-center gap-4 mb-6'>
            <span class='h-px w-12 bg-gold/70'></span>
            <span
              class='text-[10px] sm:text-xs font-semibold uppercase tracking-[0.24em] text-gold'
              >Impact Metrics</span
            >
          </div>
          <h1
            class='font-display font-light text-white text-[2.5rem] leading-[1.02] sm:text-5xl lg:text-7xl tracking-[-0.03em] text-balance'>
            The numbers,<br />
            <em class='not-italic font-normal text-primary-light'>openly</em>.
          </h1>
          <div class='mt-8 h-px w-16 bg-gold/80'></div>
        </div>
        <aside class='lg:col-span-5'>
          <p
            class='text-[15px] sm:text-base text-slate-300 leading-[1.75] max-w-md'>
            A pathway is only credible if the numbers are visible. These are our
            baseline metrics and 2030 targets &mdash; published from our
            internal MEAL framework.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50'>
    <div class='max-w-7xl mx-auto'>
      <div class='max-w-3xl mb-14'>
        <span class='eyebrow'>Baseline → 2030</span>
        <h2
          class='mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-secondary text-balance'>
          Where we are, where we&rsquo;re going.
        </h2>
      </div>

      <div class='overflow-hidden rounded-2xl border border-slate-200 bg-white'>
        <table class='w-full text-sm'>
          <thead>
            <tr class='bg-slate-50 border-b border-slate-200'>
              <th
                class='text-left px-6 py-4 text-[10px] font-semibold uppercase tracking-wider text-slate-500'
                >Indicator</th
              >
              <th
                class='text-left px-6 py-4 text-[10px] font-semibold uppercase tracking-wider text-slate-500'
                >Baseline</th
              >
              <th
                class='text-left px-6 py-4 text-[10px] font-semibold uppercase tracking-wider text-slate-500'
                >2030 Target</th
              >
              <th
                class='hidden md:table-cell text-left px-6 py-4 text-[10px] font-semibold uppercase tracking-wider text-slate-500'
                >Note</th
              >
            </tr>
          </thead>
          <tbody>
            {
              baselineMetrics.map((m) => (
                <tr class='border-b border-slate-100 last:border-0'>
                  <td class='px-6 py-4 font-semibold text-secondary'>
                    {m.indicator}
                  </td>
                  <td class='px-6 py-4 font-mono text-slate-500'>
                    {m.baseline}
                  </td>
                  <td class='px-6 py-4 font-mono text-primary font-semibold'>
                    {m.target2030}
                  </td>
                  <td class='hidden md:table-cell px-6 py-4 text-slate-500 text-xs'>
                    {m.note}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class='mt-8 text-xs text-slate-500 italic max-w-3xl'>{honestNote}</p>
    </div>
  </section>
</LandingLayout>
