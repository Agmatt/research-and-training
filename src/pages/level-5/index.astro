---
import LandingLayout from '../../layout/LandingLayout.astro';
import BaseHead from '../../components/seo/BaseHead.astro';
import { buildWebPage } from '../../components/seo/schema/webpage';
import { buildBreadcrumbs } from '../../components/seo/schema/breadcrumbs';
import { SITE } from '../../data/site';

const title =
  'Level 5 Pathway — Vision, Roadmap, Accreditation | SPMH Homa Bay';
const description =
  "St. Paul's Mission Hospital's phased pathway to Level 5 teaching hospital accreditation by 2030. Vision, roadmap, facilities, accreditation standards, and honest impact metrics.";
const path = '/level-5';
const canonical = `${SITE.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPage({ title, description, path }),
    buildBreadcrumbs([
      { name: 'Home', item: `${SITE.mainSite.url}/` },
      { name: 'Training & Research', item: `${SITE.url}/` },
      { name: 'Level 5', item: `${SITE.url}/level-5` },
    ]),
  ],
};

const sections = [
  {
    number: '01',
    title: 'Vision',
    href: '/level-5/vision',
    icon: 'compass',
    summary:
      'The 2030 vision, mission, and six strategic pillars guiding the transformation.',
    meta: 'Strategy',
  },
  {
    number: '02',
    title: 'Roadmap',
    href: '/level-5/roadmap',
    icon: 'route',
    summary:
      'Three phases — Stabilization (2026–27), Expansion (2028–29), Consolidation & Excellence (2030).',
    meta: '2026 → 2030',
  },
  {
    number: '03',
    title: 'Facilities',
    href: '/level-5/facilities',
    icon: 'hospital',
    summary:
      'Current clinical infrastructure, planned expansion, and diagnostics roadmap.',
    meta: 'Infrastructure',
  },
  {
    number: '04',
    title: 'Accreditation',
    href: '/level-5/accreditation',
    icon: 'clipboard-check',
    summary:
      'How SPMH is aligning to Kenya MoH and KMPDC standards for Level 5 teaching hospital status.',
    meta: 'MoH · KMPDC',
  },
  {
    number: '05',
    title: 'Impact Metrics',
    href: '/level-5/metrics',
    icon: 'chart-line',
    summary:
      'Honest, phased metrics tracking our pathway — published openly as milestones land.',
    meta: 'Transparency',
  },
];
---

<LandingLayout currentPage='Level 5'>
  <BaseHead
    slot='head'
    title={title}
    description={description}
    canonical={canonical}
    jsonLd={schema}
  />

  <!-- ============================================================
       HERO
       ============================================================ -->
  <section class='relative overflow-hidden bg-[#0A1730] text-white'>
    <div class='absolute inset-0 pointer-events-none' aria-hidden='true'>
      <div
        class='absolute inset-0 bg-gradient-to-br from-[#0A1730] via-[#0B1E3A] to-[#0E2549]'>
      </div>
      <div
        class='absolute -top-[30%] right-[-10%] w-[70vw] h-[70vw] rounded-full bg-[#1565c0]/[0.10] blur-[140px]'>
      </div>
      <div
        class='absolute -bottom-[30%] left-[-10%] w-[60vw] h-[60vw] rounded-full bg-[#c8a951]/[0.05] blur-[140px]'>
      </div>
    </div>

    <div
      class='relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-20 pb-16 sm:pt-28 sm:pb-20 lg:pt-32 lg:pb-24'>
      <nav aria-label='Breadcrumb' class='mb-12'>
        <ol
          class='flex flex-wrap items-center gap-2 text-[10px] sm:text-[11px] uppercase tracking-[0.24em] font-medium text-slate-500'>
          <li>
            <a href='/' class='hover:text-white transition-colors'>Home</a>
          </li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li class='text-gold'>Level 5</li>
        </ol>
      </nav>

      <div
        class='grid grid-cols-1 lg:grid-cols-12 gap-y-12 lg:gap-x-10 items-end'>
        <div class='lg:col-span-8'>
          <div class='flex items-center gap-4 mb-6 sm:mb-8'>
            <span class='h-px w-10 sm:w-14 bg-gold/70'></span>
            <span
              class='text-[10px] sm:text-xs font-semibold uppercase tracking-[0.24em] text-gold'>
              Level 4 &rarr; 5 &middot; by 2030
            </span>
          </div>

          <h1
            class='font-display font-light text-white
                     text-[2.75rem] leading-[0.98] sm:text-6xl lg:text-7xl xl:text-[5.5rem]
                     tracking-[-0.03em] text-balance'>
            A teaching<br />
            hospital<br />
            in the making.
          </h1>

          <div class='mt-8 sm:mt-10 h-px w-14 sm:w-20 bg-gold/80'></div>
        </div>

        <aside class='lg:col-span-4'>
          <p
            class='text-[15px] sm:text-base text-slate-300 leading-[1.75] max-w-sm'>
            St. Paul&rsquo;s Mission Hospital is a Level&nbsp;4 referral
            facility on a documented pathway to Level&nbsp;5 teaching hospital
            accreditation. This is the full picture &mdash; strategy,
            infrastructure, standards, and evidence.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <!-- ============================================================
       DIRECTORY — five cards
       ============================================================ -->
  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50'>
    <div class='max-w-7xl mx-auto'>
      <div class='max-w-3xl mb-14'>
        <span class='eyebrow'>Explore the Pathway</span>
        <h2
          class='mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-secondary text-balance'>
          Five ways to see the work.
        </h2>
        <p class='mt-5 text-base sm:text-lg text-slate-600 leading-relaxed'>
          Each section documents a different dimension of the pathway. Read them
          in sequence, or start wherever you are curious.
        </p>
      </div>

      <div
        class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-7'>
        {
          sections.map((s) => (
            <a
              href={s.href}
              class='group relative flex flex-col rounded-2xl border border-slate-200 bg-white
                    p-6 sm:p-8 shadow-sm hover:-translate-y-1 hover:shadow-xl
                    hover:border-blue-200 transition-all duration-300'>
              <div class='flex items-center justify-between mb-6'>
                <span class='font-mono text-xs text-slate-400 tracking-wider'>
                  {s.number}
                </span>
                <span class='text-[10px] uppercase tracking-[0.2em] font-semibold text-slate-400'>
                  {s.meta}
                </span>
              </div>

              <div
                class='w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-5
                        group-hover:bg-primary group-hover:text-white transition-colors'>
                <i class={`fas fa-${s.icon} text-lg`} aria-hidden='true' />
              </div>

              <h3 class='text-xl font-bold text-secondary'>{s.title}</h3>
              <p class='mt-3 text-sm text-slate-600 leading-relaxed flex-1'>
                {s.summary}
              </p>

              <span
                class='mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary
                         group-hover:gap-3 transition-all'>
                Read more
                <i class='fas fa-arrow-right text-xs' aria-hidden='true' />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================
       CLOSING BAND
       ============================================================ -->
  <section
    class='py-20 sm:py-24 px-4 sm:px-6 lg:px-8 bg-white border-t border-slate-100'>
    <div class='max-w-3xl mx-auto text-center'>
      <div class='mx-auto h-px w-16 bg-gold/70 mb-10'></div>
      <h2 class='text-3xl sm:text-4xl font-bold text-secondary text-balance'>
        Building a hospital worth training at.
      </h2>
      <p class='mt-5 text-base text-slate-600 leading-relaxed'>
        Students, partners, and researchers &mdash; if the pathway aligns with
        your work, we&rsquo;d like to hear from you.
      </p>
      <div
        class='mt-10 flex flex-col sm:flex-row justify-center gap-3 sm:gap-4'>
        <a href='/apply/clinical' class='btn-primary px-6 py-3.5'>
          Apply for clinical attachment
          <i class='fas fa-arrow-right text-xs' aria-hidden='true'></i>
        </a>
        <a href='/collaborate/inquiry' class='btn-secondary px-6 py-3.5'>
          Explore partnership
        </a>
      </div>
    </div>
  </section>
</LandingLayout>
