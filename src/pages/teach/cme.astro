---
import LandingLayout from '../../layout/LandingLayout.astro';
import BaseHead from '../../components/seo/BaseHead.astro';
import { buildWebPage } from '../../components/seo/schema/webpage';
import { buildBreadcrumbs } from '../../components/seo/schema/breadcrumbs';
import { SITE } from '../../data/site';

const title = 'Continuing Medical Education (CME) — SPMH Homa Bay';
const description =
  'Modular CME sessions, CPD credits, case-based teaching, and clinical updates for practising health professionals in Western Kenya.';
const path = '/teach/cme';
const canonical = `${SITE.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPage({ title, description, path }),
    buildBreadcrumbs([
      { name: 'Home', item: `${SITE.mainSite.url}/` },
      { name: 'Training & Research', item: `${SITE.url}/` },
      { name: 'Teach', item: `${SITE.url}/teach` },
      { name: 'CME', item: `${SITE.url}/teach/cme` },
    ]),
  ],
};

const sessions = [
  {
    title: 'Emergency & Trauma Care',
    frequency: 'Monthly',
    format: 'Case-based + simulation',
  },
  {
    title: 'Maternal & Newborn Emergencies',
    frequency: 'Monthly',
    format: 'Case conference + drill',
  },
  {
    title: 'NCD Management',
    frequency: 'Quarterly',
    format: 'Clinical update',
  },
  {
    title: 'Infection Prevention & Control',
    frequency: 'Quarterly',
    format: 'Workshop',
  },
  {
    title: 'Digital Health & EMR',
    frequency: 'Quarterly',
    format: 'Hands-on session',
  },
  {
    title: 'Ethics & Professionalism',
    frequency: 'Biannual',
    format: 'Seminar',
  },
];

const cpdInfo = [
  {
    label: 'CPD Credits',
    value: 'Awarded per session, in line with regulator requirements.',
  },
  {
    label: 'Format',
    value: 'In-person at SPMH, with selected sessions offered as hybrid.',
  },
  {
    label: 'Who can attend',
    value:
      'Registered health professionals: doctors, nurses, clinical officers, pharmacists, lab technologists.',
  },
  {
    label: 'Cost',
    value: 'Free for SPMH staff. External attendees: KES 1,000 per session.',
  },
  {
    label: 'Registration',
    value: 'Advance registration required. Contact education@spmh.co.ke.',
  },
  {
    label: 'Certificates',
    value: 'CPD certificates issued within 5 working days of attendance.',
  },
];
---

<LandingLayout currentPage='Teach'>
  <BaseHead
    slot='head'
    title={title}
    description={description}
    canonical={canonical}
    jsonLd={schema}
  />

  <section class='relative bg-[#0A1730] text-white'>
    <div
      class='absolute inset-0 bg-gradient-to-br from-[#0A1730] via-[#0B1E3A] to-[#0E2549]'>
    </div>
    <div
      class='relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-20 pb-16 sm:pt-28 sm:pb-20'>
      <nav aria-label='Breadcrumb' class='mb-12'>
        <ol
          class='flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.24em] font-medium text-slate-500'>
          <li><a href='/' class='hover:text-white'>Home</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li><a href='/teach' class='hover:text-white'>Teach</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li class='text-gold'>CME</li>
        </ol>
      </nav>
      <div
        class='grid grid-cols-1 lg:grid-cols-12 gap-y-10 lg:gap-x-10 items-end'>
        <div class='lg:col-span-7'>
          <div class='flex items-center gap-4 mb-6'>
            <span class='h-px w-12 bg-gold/70'></span>
            <span
              class='text-[10px] sm:text-xs font-semibold uppercase tracking-[0.24em] text-gold'
              >Continuing Education</span
            >
          </div>
          <h1
            class='font-display font-light text-white text-[2.5rem] leading-[1.02] sm:text-5xl lg:text-7xl tracking-[-0.03em] text-balance'>
            Learning<br />
            never <em class='not-italic font-normal text-primary-light'
              >stops</em
            >.
          </h1>
          <div class='mt-8 h-px w-16 bg-gold/80'></div>
        </div>
        <aside class='lg:col-span-5'>
          <p
            class='text-[15px] sm:text-base text-slate-300 leading-[1.75] max-w-md'>
            Modular CME sessions, case-based teaching, and clinical updates for
            practising health professionals across Western Kenya. CPD credits
            awarded per session.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50'>
    <div class='max-w-7xl mx-auto'>
      <div class='max-w-3xl mb-14'>
        <span class='eyebrow'>Sessions</span>
        <h2
          class='mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-secondary text-balance'>
          What we offer.
        </h2>
      </div>
      <div class='overflow-hidden rounded-2xl border border-slate-200 bg-white'>
        <table class='w-full text-sm'>
          <thead>
            <tr class='bg-slate-50 border-b border-slate-200'>
              <th
                class='text-left px-6 py-4 text-[10px] font-semibold uppercase tracking-wider text-slate-500'
                >Session</th
              >
              <th
                class='text-left px-6 py-4 text-[10px] font-semibold uppercase tracking-wider text-slate-500'
                >Frequency</th
              >
              <th
                class='hidden md:table-cell text-left px-6 py-4 text-[10px] font-semibold uppercase tracking-wider text-slate-500'
                >Format</th
              >
            </tr>
          </thead>
          <tbody>
            {
              sessions.map((s) => (
                <tr class='border-b border-slate-100 last:border-0'>
                  <td class='px-6 py-4 font-semibold text-secondary'>
                    {s.title}
                  </td>
                  <td class='px-6 py-4 text-slate-600'>{s.frequency}</td>
                  <td class='hidden md:table-cell px-6 py-4 text-slate-600'>
                    {s.format}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-white'>
    <div
      class='max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-y-12 lg:gap-x-16'>
      <div class='lg:col-span-5'>
        <span class='eyebrow'>Logistics</span>
        <h2
          class='mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-secondary text-balance'>
          Attendance details.
        </h2>
        <div class='mt-10 h-px w-16 bg-gold/70'></div>
      </div>
      <div class='lg:col-span-7'>
        <ul class='divide-y divide-slate-100 border-y border-slate-100'>
          {
            cpdInfo.map((c) => (
              <li class='py-5 grid grid-cols-1 sm:grid-cols-12 gap-2 sm:gap-4'>
                <p class='sm:col-span-4 text-sm font-semibold text-secondary'>
                  {c.label}
                </p>
                <p class='sm:col-span-8 text-sm text-slate-600 leading-relaxed'>
                  {c.value}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section
    class='py-20 px-4 sm:px-6 lg:px-8 bg-white border-t border-slate-100'>
    <div class='max-w-3xl mx-auto text-center'>
      <div class='mx-auto h-px w-16 bg-gold/70 mb-10'></div>
      <h2 class='text-3xl sm:text-4xl font-bold text-secondary text-balance'>
        Register for a session.
      </h2>
      <p class='mt-5 text-base text-slate-600 leading-relaxed'>
        Contact our education office to register for upcoming CME sessions.
      </p>
      <div
        class='mt-10 flex flex-col sm:flex-row justify-center gap-3 sm:gap-4'>
        <a href='mailto:academics@spmh.co.ke' class='btn-primary px-6 py-3.5'>
          Email education office <i
            class='fas fa-arrow-right text-xs'
            aria-hidden='true'></i>
        </a>
      </div>
    </div>
  </section>
</LandingLayout>
