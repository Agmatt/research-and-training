---
import LandingLayout from '../../layout/LandingLayout.astro';
import BaseHead from '../../components/seo/BaseHead.astro';
import { buildWebPage } from '../../components/seo/schema/webpage';
import { buildBreadcrumbs } from '../../components/seo/schema/breadcrumbs';
import { SITE } from '../../data/site';

const title = 'Teaching Resources — Handbooks & Materials | SPMH';
const description =
  'Preceptor handbook, teaching materials, and structured learning resources for clinical educators at SPMH.';
const path = '/teach/resources';
const canonical = `${SITE.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPage({ title, description, path }),
    buildBreadcrumbs([
      { name: 'Home', item: `${SITE.mainSite.url}/` },
      { name: 'Training & Research', item: `${SITE.url}/` },
      { name: 'Teach', item: `${SITE.url}/teach` },
      { name: 'Resources', item: `${SITE.url}/teach/resources` },
    ]),
  ],
};

const resources = [
  {
    title: 'Preceptor Handbook',
    desc: 'Roles, expectations, and supervision standards for clinical preceptors.',
    href: '/files/preceptor-handbook.pdf',
  },
  {
    title: 'Student Onboarding Guide',
    desc: 'What students should expect on day one, and how to prepare.',
    href: '/files/student-onboarding.pdf',
  },
  {
    title: 'Competency Frameworks',
    desc: 'Structured competency frameworks by cadre.',
    href: '/files/competency-frameworks.pdf',
  },
  {
    title: 'Internship Manual',
    desc: 'Full internship programme documentation.',
    href: '/files/internship-manual.pdf',
  },
  {
    title: 'Clinical Teaching Materials',
    desc: 'Case studies, teaching aids, and simulation scenarios.',
    href: '/files/preceptor-handbook.pdf',
  },
  {
    title: 'Assessment Tools',
    desc: 'Standard assessment templates for rotations and internships.',
    href: '/files/competency-frameworks.pdf',
  },
];
---

<LandingLayout currentPage='Teach'>
  <BaseHead
    slot='head'
    title={title}
    description={description}
    canonical={canonical}
    jsonLd={schema}
  />

  <section class='relative bg-[#0A1730] text-white'>
    <div
      class='absolute inset-0 bg-gradient-to-br from-[#0A1730] via-[#0B1E3A] to-[#0E2549]'>
    </div>
    <div
      class='relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-20 pb-16 sm:pt-28 sm:pb-20'>
      <nav aria-label='Breadcrumb' class='mb-12'>
        <ol
          class='flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.24em] font-medium text-slate-500'>
          <li><a href='/' class='hover:text-white'>Home</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li><a href='/teach' class='hover:text-white'>Teach</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li class='text-gold'>Resources</li>
        </ol>
      </nav>
      <div
        class='grid grid-cols-1 lg:grid-cols-12 gap-y-10 lg:gap-x-10 items-end'>
        <div class='lg:col-span-7'>
          <div class='flex items-center gap-4 mb-6'>
            <span class='h-px w-12 bg-gold/70'></span>
            <span
              class='text-[10px] sm:text-xs font-semibold uppercase tracking-[0.24em] text-gold'
              >Teaching Materials</span
            >
          </div>
          <h1
            class='font-display font-light text-white text-[2.5rem] leading-[1.02] sm:text-5xl lg:text-7xl tracking-[-0.03em] text-balance'>
            Handbooks, guides,<br />
            and <em class='not-italic font-normal text-primary-light'
              >frameworks</em
            >.
          </h1>
          <div class='mt-8 h-px w-16 bg-gold/80'></div>
        </div>
        <aside class='lg:col-span-5'>
          <p
            class='text-[15px] sm:text-base text-slate-300 leading-[1.75] max-w-md'>
            Structured learning resources for clinical educators and preceptors
            at SPMH. All materials are periodically reviewed against regulator
            standards.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50'>
    <div class='max-w-7xl mx-auto'>
      <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5'>
        {
          resources.map((r) => (
            <a
              href={r.href}
              download
              class='group rounded-2xl border border-slate-200 bg-white p-6
                     hover:-translate-y-1 hover:shadow-lg hover:border-blue-200 transition-all'>
              <div class='w-11 h-11 rounded-lg bg-red-50 text-red-600 flex items-center justify-center mb-5'>
                <i class='fas fa-file-pdf text-base' aria-hidden='true' />
              </div>
              <h3 class='text-base font-bold text-secondary'>{r.title}</h3>
              <p class='mt-2 text-sm text-slate-600 leading-relaxed'>
                {r.desc}
              </p>
              <span class='mt-5 inline-flex items-center gap-2 text-xs font-semibold text-primary group-hover:gap-3 transition-all'>
                <i class='fas fa-download' aria-hidden='true' />
                Download
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</LandingLayout>
