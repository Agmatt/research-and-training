---
import LandingLayout from '../../../layout/LandingLayout.astro';
import BaseHead from '../../../components/seo/BaseHead.astro';
import { buildWebPage } from '../../../components/seo/schema/webpage';
import { buildBreadcrumbs } from '../../../components/seo/schema/breadcrumbs';
import { getCollection } from 'astro:content';
import { SITE } from '../../../data/site';
import '../../../styles/global.css';

const title = 'CME Calendar — Upcoming Sessions | SPMH Homa Bay';
const description =
  'Upcoming continuing medical education sessions at St. Paul\'s Mission Hospital. Case-based workshops, simulation drills, and clinical updates with CPD credits.';
const path = '/teach/cme/calendar';
const canonical = `${SITE.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPage({ title, description, path }),
    buildBreadcrumbs([
      { name: 'Home', item: `${SITE.mainSite.url}/` },
      { name: 'Training & Research', item: `${SITE.url}/` },
      { name: 'Teach', item: `${SITE.url}/teach` },
      { name: 'CME', item: `${SITE.url}/teach/cme` },
      { name: 'Calendar', item: `${SITE.url}/teach/cme/calendar` },
    ]),
  ],
};

/* ---------- Fetch + sort sessions ---------- */
const today = new Date();
today.setHours(0, 0, 0, 0);

const allSessions = await getCollection('cme');

const upcoming = allSessions
  .filter((s) => s.data.date >= today)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

/* ---------- Group by month ---------- */
const monthFormatter = new Intl.DateTimeFormat('en-KE', {
  month: 'long',
  year: 'numeric',
});
const dayFormatter = new Intl.DateTimeFormat('en-KE', {
  weekday: 'short',
});

type MonthGroup = {
  key: string;
  label: string;
  sessions: typeof upcoming;
};

const groups: MonthGroup[] = [];
for (const session of upcoming) {
  const key = `${session.data.date.getFullYear()}-${session.data.date.getMonth()}`;
  const label = monthFormatter.format(session.data.date);
  let group = groups.find((g) => g.key === key);
  if (!group) {
    group = { key, label, sessions: [] };
    groups.push(group);
  }
  group.sessions.push(session);
}

/* ---------- Helpers ---------- */
const formatShortDate = (d: Date) =>
  d.toLocaleDateString('en-KE', { day: 'numeric', month: 'short', year: 'numeric' });

function durationLabel(format: string) {
  if (format === 'Online') return 'Online session';
  if (format === 'Hybrid') return 'Hybrid — attend in person or online';
  return 'In-person session';
}
---

<LandingLayout currentPage="Teach">
  <BaseHead slot="head" title={title} description={description} canonical={canonical} jsonLd={schema} />

  <!-- ============================================================
       Hero
       ============================================================ -->
  <section class="relative overflow-hidden bg-[#0A1730] text-white">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0 bg-gradient-to-br from-[#0A1730] via-[#0B1E3A] to-[#0E2549]"></div>
      <div class="absolute -top-[30%] right-[-10%] w-[70vw] h-[70vw] rounded-full bg-[#1565c0]/[0.10] blur-[140px]"></div>
      <div class="absolute -bottom-[30%] left-[-10%] w-[60vw] h-[60vw] rounded-full bg-[#c8a951]/[0.05] blur-[140px]"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-20 pb-16 sm:pt-24 sm:pb-20">
      <nav aria-label="Breadcrumb" class="mb-10">
        <ol class="flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.24em] font-medium text-slate-500">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li aria-hidden="true" class="text-slate-700">/</li>
          <li><a href="/teach" class="hover:text-white transition-colors">Teach</a></li>
          <li aria-hidden="true" class="text-slate-700">/</li>
          <li><a href="/teach/cme" class="hover:text-white transition-colors">CME</a></li>
          <li aria-hidden="true" class="text-slate-700">/</li>
          <li class="text-gold">Calendar</li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-10 lg:gap-x-10 items-end">
        <div class="lg:col-span-7">
          <div class="flex items-center gap-4 mb-6">
            <span class="h-px w-12 bg-gold/70"></span>
            <span class="text-[10px] sm:text-xs font-semibold uppercase tracking-[0.24em] text-gold">
              CME Calendar
            </span>
          </div>
          <h1 class="font-display font-light text-white text-[2.5rem] leading-[1.02] sm:text-5xl lg:text-7xl tracking-[-0.03em] text-balance">
            Upcoming<br />
            <em class="not-italic font-normal text-primary-light">sessions</em>.
          </h1>
          <div class="mt-8 h-px w-16 bg-gold/80"></div>
        </div>
        <aside class="lg:col-span-5">
          <p class="text-[15px] sm:text-base text-slate-300 leading-[1.75] max-w-md">
            Case-based workshops, simulation drills, and clinical updates.
            CPD credits awarded per session. Registration required in advance.
          </p>
          <div class="mt-10">
            <a href="/teach/cme"
               class="inline-flex items-center px-6 py-3 rounded-full border border-white/20 text-white text-sm font-medium
                      hover:bg-white/[0.06] hover:border-white/40 transition-colors">
              Back to CME overview
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ============================================================
       Sessions
       ============================================================ -->
  <section class="py-20 sm:py-24 px-4 sm:px-6 lg:px-8 bg-slate-50">
    <div class="max-w-5xl mx-auto">
      {groups.length === 0 ? (
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center">
          <div class="w-14 h-14 rounded-full bg-blue-50 text-primary flex items-center justify-center mx-auto mb-5">
            <i class="fas fa-calendar text-xl" aria-hidden="true" />
          </div>
          <h2 class="text-xl font-bold text-secondary mb-2">No upcoming sessions scheduled</h2>
          <p class="text-sm text-slate-600 max-w-md mx-auto leading-relaxed">
            New CME sessions are added throughout the year. Check back soon, or
            contact our education office to be notified.
          </p>
          <a href="mailto:academics@spmh.co.ke" class="mt-6 inline-flex btn-primary px-5 py-2.5">
            Email education office
          </a>
        </div>
      ) : (
        <div class="space-y-12">
          {groups.map((group) => (
            <div>
              <!-- Month header -->
              <div class="flex items-center gap-4 mb-6">
                <h2 class="font-display font-light text-2xl text-slate-900">{group.label}</h2>
                <span class="h-px flex-1 bg-slate-200"></span>
                <span class="text-xs text-slate-400 font-mono">
                  {group.sessions.length} {group.sessions.length === 1 ? 'session' : 'sessions'}
                </span>
              </div>

              <ul class="space-y-4">
                {group.sessions.map((session) => (
                  <li>
                    <a href={`/teach/cme/sessions/${session.id}`}
                       class="group block rounded-2xl border border-slate-200 bg-white
                              hover:border-primary/30 hover:shadow-lg transition-all overflow-hidden">
                      <div class="grid grid-cols-1 md:grid-cols-12">
                        <!-- Date column -->
                        <div class="md:col-span-2 p-6 md:border-r border-slate-100 flex md:block items-center gap-4">
                          <div class="text-center md:text-left">
                            <div class="font-display text-3xl md:text-4xl font-light text-secondary leading-none">
                              {session.data.date.getDate()}
                            </div>
                            <div class="mt-1 text-[10px] font-semibold uppercase tracking-wider text-slate-400">
                              {dayFormatter.format(session.data.date).replace(',', '')}
                            </div>
                          </div>
                          <div class="md:mt-3 text-xs text-slate-500 md:text-left">
                            {session.data.time}
                          </div>
                        </div>

                        <!-- Content column -->
                        <div class="md:col-span-10 p-6 flex flex-col">
                          <div class="flex flex-wrap items-center gap-2 mb-3">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full
                                         text-[10px] font-semibold uppercase tracking-wider
                                         bg-primary/10 text-primary">
                              {session.data.category}
                            </span>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full
                                         text-[10px] font-semibold uppercase tracking-wider
                                         bg-slate-50 text-slate-600 ring-1 ring-slate-200">
                              {session.data.format}
                            </span>
                            {session.data.credits && (
                              <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-600">
                                {session.data.credits}
                              </span>
                            )}
                          </div>

                          <h3 class="text-lg font-bold text-secondary group-hover:text-primary transition-colors">
                            {session.data.title}
                          </h3>

                          <p class="mt-2 text-sm text-slate-600 leading-relaxed line-clamp-2">
                            {session.data.description}
                          </p>

                          <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-slate-500">
                            <span class="flex items-center gap-1.5">
                              <i class="fas fa-location-dot" aria-hidden="true" />
                              {session.data.location}
                            </span>
                            {session.data.facilitator && (
                              <span class="flex items-center gap-1.5">
                                <i class="fas fa-user-tie" aria-hidden="true" />
                                {session.data.facilitator}
                              </span>
                            )}
                          </div>
                        </div>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}

      <!-- Registration CTA -->
      <div class="mt-16 rounded-2xl bg-slate-900 text-white p-8 sm:p-10">
        <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
          <div>
            <h2 class="text-2xl font-bold text-white">How to register</h2>
            <p class="mt-3 text-slate-300 max-w-2xl leading-relaxed">
              Advance registration is required. CME sessions are free for SPMH
              staff; external attendees pay KES 1,000 per session. CPD
              certificates are issued within 5 working days of attendance.
            </p>
          </div>
          <a href="mailto:academics@spmh.co.ke"
             class="btn-primary px-6 py-3.5 shrink-0">
            Email to register <i class="fas fa-arrow-right text-xs" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>