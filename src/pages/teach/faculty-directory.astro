---
import LandingLayout from '../../layout/LandingLayout.astro';
import BaseHead from '../../components/seo/BaseHead.astro';
import { buildWebPage } from '../../components/seo/schema/webpage';
import { buildBreadcrumbs } from '../../components/seo/schema/breadcrumbs';
import { SITE } from '../../data/site';
import { faculty } from '../../components/seo/schema/faculty';

const title = 'Faculty & Preceptors Directory — SPMH Homa Bay';
const description =
  "Certified clinical preceptors and faculty who supervise attachments and internships at St. Paul's Mission Hospital.";
const path = '/teach/faculty-directory';
const canonical = `${SITE.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPage({ title, description, path }),
    buildBreadcrumbs([
      { name: 'Home', item: `${SITE.mainSite.url}/` },
      { name: 'Training & Research', item: `${SITE.url}/` },
      { name: 'Teach', item: `${SITE.url}/teach` },
      {
        name: 'Faculty Directory',
        item: `${SITE.url}/teach/faculty-directory`,
      },
    ]),
  ],
};
---

<LandingLayout currentPage='Teach'>
  <BaseHead
    slot='head'
    title={title}
    description={description}
    canonical={canonical}
    jsonLd={schema}
  />

  <section class='relative bg-[#0A1730] text-white'>
    <div
      class='absolute inset-0 bg-gradient-to-br from-[#0A1730] via-[#0B1E3A] to-[#0E2549]'>
    </div>
    <div
      class='relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-20 pb-16 sm:pt-28 sm:pb-20'>
      <nav aria-label='Breadcrumb' class='mb-12'>
        <ol
          class='flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.24em] font-medium text-slate-500'>
          <li><a href='/' class='hover:text-white'>Home</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li><a href='/teach' class='hover:text-white'>Teach</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li class='text-gold'>Faculty</li>
        </ol>
      </nav>
      <div
        class='grid grid-cols-1 lg:grid-cols-12 gap-y-10 lg:gap-x-10 items-end'>
        <div class='lg:col-span-7'>
          <div class='flex items-center gap-4 mb-6'>
            <span class='h-px w-12 bg-gold/70'></span>
            <span
              class='text-[10px] sm:text-xs font-semibold uppercase tracking-[0.24em] text-gold'
              >Faculty &amp; Preceptors</span
            >
          </div>
          <h1
            class='font-display font-light text-white text-[2.5rem] leading-[1.02] sm:text-5xl lg:text-7xl tracking-[-0.03em] text-balance'>
            The people who<br />
            teach the <em class='not-italic font-normal text-primary-light'
              >future</em
            >.
          </h1>
          <div class='mt-8 h-px w-16 bg-gold/80'></div>
        </div>
        <aside class='lg:col-span-5'>
          <p
            class='text-[15px] sm:text-base text-slate-300 leading-[1.75] max-w-md'>
            Every attachment and internship rotation is supervised by a
            registered, practising clinician. This is our current preceptor team
            &mdash; the directory grows as the Level&nbsp;5 pathway progresses.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50'>
    <div class='max-w-7xl mx-auto'>
      <div class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6'>
        {
          faculty.map((member) => {
            const initials = member.name
              .split(' ')
              .map((n) => n[0])
              .join('')
              .slice(0, 2)
              .toUpperCase();
            return (
              <article
                class='group rounded-2xl border border-slate-200 bg-white p-6 text-center
                            hover:-translate-y-1 hover:shadow-xl hover:border-blue-200 transition-all'>
                {member.photo ? (
                  <div class='w-24 h-24 rounded-full overflow-hidden bg-slate-100 ring-2 ring-blue-100 mx-auto'>
                    <img
                      src={member.photo}
                      alt={`Portrait of ${member.name}`}
                      class='w-full h-full object-cover object-top'
                      loading='lazy'
                      decoding='async'
                    />
                  </div>
                ) : (
                  <div
                    class='w-24 h-24 rounded-full ring-2 ring-blue-100 bg-gradient-to-br from-blue-100 to-blue-200
                            flex items-center justify-center mx-auto'>
                    <span class='text-2xl font-bold text-secondary'>
                      {initials}
                    </span>
                  </div>
                )}
                <h2 class='mt-5 text-lg font-bold text-secondary leading-tight'>
                  {member.name}
                </h2>
                <p class='text-sm text-primary font-semibold mt-1'>
                  {member.title}
                </p>
                <p class='text-xs text-slate-500 mt-2 uppercase tracking-wider font-medium'>
                  {member.specialty}
                </p>
                <p class='mt-4 text-xs text-slate-600 leading-relaxed'>
                  {member.bio}
                </p>
              </article>
            );
          })
        }
      </div>

      <div
        class='mt-14 rounded-2xl bg-slate-900 text-white p-8 sm:p-10 text-center'>
        <h3 class='text-2xl font-bold text-white'>
          Interested in joining the faculty?
        </h3>
        <p class='mt-3 text-slate-300 max-w-2xl mx-auto'>
          SPMH welcomes visiting faculty, exchange clinicians, and CME
          collaborators. Contact our academic office to discuss options.
        </p>
        <a
          href='/collaborate/inquiry'
          class='mt-6 inline-flex btn-primary px-6 py-3'>
          Faculty collaboration <i
            class='fas fa-arrow-right text-xs'
            aria-hidden='true'></i>
        </a>
      </div>
    </div>
  </section>
</LandingLayout>
