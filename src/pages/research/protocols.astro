---
import LandingLayout from '../../layout/LandingLayout.astro';
import BaseHead from '../../components/seo/BaseHead.astro';
import { buildWebPage } from '../../components/seo/schema/webpage';
import { buildBreadcrumbs } from '../../components/seo/schema/breadcrumbs';
import { SITE } from '../../data/site';

const title = 'Research Protocols & Templates | SPMH';
const description =
  'Protocol templates, data management guidance, and study design resources for researchers collaborating with SPMH.';
const path = '/research/protocols';
const canonical = `${SITE.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPage({ title, description, path }),
    buildBreadcrumbs([
      { name: 'Home', item: `${SITE.mainSite.url}/` },
      { name: 'Training & Research', item: `${SITE.url}/` },
      { name: 'Research', item: `${SITE.url}/research` },
      { name: 'Protocols', item: `${SITE.url}/research/protocols` },
    ]),
  ],
};

const downloads = [
  {
    title: 'Study Protocol Template',
    desc: 'Standard format for full study protocols.',
    href: '/files/research-protocols.pdf',
    size: 'PDF',
  },
  {
    title: 'Informed Consent Template',
    desc: 'English and Kiswahili consent form formats.',
    href: '/files/research-protocols.pdf',
    size: 'PDF',
  },
  {
    title: 'Data Collection Tools Template',
    desc: 'Structured data capture formats.',
    href: '/files/research-protocols.pdf',
    size: 'PDF',
  },
  {
    title: 'Researcher Guidelines',
    desc: 'Standards, expectations, and author responsibilities.',
    href: '/files/research-guidelines.pdf',
    size: 'PDF',
  },
  {
    title: 'SPMH Data Management Framework',
    desc: 'How data is stored, shared, and protected.',
    href: '/files/research-guidelines.pdf',
    size: 'PDF',
  },
  {
    title: 'Publication Policy',
    desc: 'Authorship, acknowledgements, and IP arrangements.',
    href: '/files/research-guidelines.pdf',
    size: 'PDF',
  },
];

const dataPrinciples = [
  {
    title: 'Kenya Data Protection Act',
    detail:
      'All data handling complies with the Kenya Data Protection Act 2019.',
  },
  {
    title: 'De-identification by Default',
    detail: 'Personal identifiers are removed before analysis or sharing.',
  },
  {
    title: 'Secure Storage',
    detail: 'Data stored on SPMH systems under role-based access control.',
  },
  {
    title: 'Institutional Ownership',
    detail:
      'SPMH retains joint ownership of data collected within its facilities.',
  },
  {
    title: 'Ethics Committee Oversight',
    detail: 'Any data-sharing beyond the approved protocol requires re-review.',
  },
];
---

<LandingLayout currentPage='Research'>
  <BaseHead
    slot='head'
    title={title}
    description={description}
    canonical={canonical}
    jsonLd={schema}
  />

  <section class='relative bg-[#0A1730] text-white'>
    <div
      class='absolute inset-0 bg-gradient-to-br from-[#0A1730] via-[#0B1E3A] to-[#0E2549]'>
    </div>
    <div
      class='relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-20 pb-16 sm:pt-28 sm:pb-20'>
      <nav aria-label='Breadcrumb' class='mb-12'>
        <ol
          class='flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.24em] font-medium text-slate-500'>
          <li><a href='/' class='hover:text-white'>Home</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li><a href='/research' class='hover:text-white'>Research</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li class='text-gold'>Protocols</li>
        </ol>
      </nav>
      <div
        class='grid grid-cols-1 lg:grid-cols-12 gap-y-10 lg:gap-x-10 items-end'>
        <div class='lg:col-span-7'>
          <div class='flex items-center gap-4 mb-6'>
            <span class='h-px w-12 bg-gold/70'></span>
            <span
              class='text-[10px] sm:text-xs font-semibold uppercase tracking-[0.24em] text-gold'
              >Resources</span
            >
          </div>
          <h1
            class='font-display font-light text-white text-[2.5rem] leading-[1.02] sm:text-5xl lg:text-7xl tracking-[-0.03em] text-balance'>
            Protocols,<br />
            templates, and <em class='not-italic font-normal text-primary-light'
              >guidelines</em
            >.
          </h1>
          <div class='mt-8 h-px w-16 bg-gold/80'></div>
        </div>
        <aside class='lg:col-span-5'>
          <p
            class='text-[15px] sm:text-base text-slate-300 leading-[1.75] max-w-md'>
            Standards and templates that guide collaboration with SPMH. Reading
            these before proposing will speed up your ethics review.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50'>
    <div class='max-w-7xl mx-auto'>
      <div class='max-w-3xl mb-14'>
        <span class='eyebrow'>Downloads</span>
        <h2
          class='mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-secondary text-balance'>
          Templates &amp; guidelines.
        </h2>
      </div>

      <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5'>
        {
          downloads.map((d) => (
            <a
              href={d.href}
              download
              class='group rounded-2xl border border-slate-200 bg-white p-6
                     hover:-translate-y-1 hover:shadow-lg hover:border-blue-200 transition-all'>
              <div class='flex items-start justify-between mb-5'>
                <div class='w-11 h-11 rounded-lg bg-red-50 text-red-600 flex items-center justify-center'>
                  <i class='fas fa-file-pdf text-base' aria-hidden='true' />
                </div>
                <span class='text-[10px] font-semibold uppercase tracking-wider text-slate-400'>
                  {d.size}
                </span>
              </div>
              <h3 class='text-base font-bold text-secondary'>{d.title}</h3>
              <p class='mt-2 text-sm text-slate-600 leading-relaxed'>
                {d.desc}
              </p>
              <span class='mt-5 inline-flex items-center gap-2 text-xs font-semibold text-primary group-hover:gap-3 transition-all'>
                <i class='fas fa-download' aria-hidden='true' />
                Download
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id='data-management'
    class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-white'>
    <div
      class='max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-y-12 lg:gap-x-16'>
      <div class='lg:col-span-5'>
        <span class='eyebrow'>Data Management</span>
        <h2
          class='mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-secondary text-balance'>
          How we handle data.
        </h2>
        <p class='mt-5 text-base text-slate-600 leading-relaxed'>
          Data governance is not a formality. These principles apply to every
          collaboration, and they are non-negotiable.
        </p>
        <div class='mt-10 h-px w-16 bg-gold/70'></div>
      </div>
      <div class='lg:col-span-7'>
        <ul class='divide-y divide-slate-100 border-y border-slate-100'>
          {
            dataPrinciples.map((p) => (
              <li class='py-5'>
                <h3 class='text-sm font-bold text-secondary'>{p.title}</h3>
                <p class='mt-1.5 text-sm text-slate-600 leading-relaxed'>
                  {p.detail}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</LandingLayout>
