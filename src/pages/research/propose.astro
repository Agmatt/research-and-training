---
import LandingLayout from '../../layout/LandingLayout.astro';
import BaseHead from '../../components/seo/BaseHead.astro';
import { buildWebPage } from '../../components/seo/schema/webpage';
import { buildBreadcrumbs } from '../../components/seo/schema/breadcrumbs';
import { SITE } from '../../data/site';

const title = 'Propose a Research Project — SPMH Collaboration';
const description =
  "Submit a research proposal aligned with SPMH's Key Result Areas and mission. Ethics review and collaboration framework included.";
const path = '/research/propose';
const canonical = `${SITE.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPage({ title, description, path }),
    buildBreadcrumbs([
      { name: 'Home', item: `${SITE.mainSite.url}/` },
      { name: 'Training & Research', item: `${SITE.url}/` },
      { name: 'Research', item: `${SITE.url}/research` },
      { name: 'Propose', item: `${SITE.url}/research/propose` },
    ]),
  ],
};

const requirements = [
  {
    title: 'Alignment with a KRA',
    detail:
      'Your proposal must align with at least one of our four Key Result Areas.',
  },
  {
    title: 'Clear research question',
    detail: 'A specific, answerable question with defined scope.',
  },
  {
    title: 'Methodology',
    detail: 'Study design, sampling, data collection, and analysis plan.',
  },
  {
    title: 'Ethical considerations',
    detail: 'Consent process, risk mitigation, and data protection measures.',
  },
  {
    title: 'Timeline',
    detail: 'Realistic start and end dates with milestones.',
  },
  {
    title: 'Collaboration intent',
    detail: 'What you bring, and what you need from SPMH.',
  },
];
---

<LandingLayout currentPage='Research'>
  <BaseHead
    slot='head'
    title={title}
    description={description}
    canonical={canonical}
    jsonLd={schema}
  />

  <section class='relative bg-[#0A1730] text-white'>
    <div
      class='absolute inset-0 bg-gradient-to-br from-[#0A1730] via-[#0B1E3A] to-[#0E2549]'>
    </div>
    <div
      class='relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-20 pb-16 sm:pt-28 sm:pb-20'>
      <nav aria-label='Breadcrumb' class='mb-12'>
        <ol
          class='flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.24em] font-medium text-slate-500'>
          <li><a href='/' class='hover:text-white'>Home</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li><a href='/research' class='hover:text-white'>Research</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li class='text-gold'>Propose</li>
        </ol>
      </nav>
      <div
        class='grid grid-cols-1 lg:grid-cols-12 gap-y-10 lg:gap-x-10 items-end'>
        <div class='lg:col-span-7'>
          <div class='flex items-center gap-4 mb-6'>
            <span class='h-px w-12 bg-gold/70'></span>
            <span
              class='text-[10px] sm:text-xs font-semibold uppercase tracking-[0.24em] text-gold'
              >Submit a Proposal</span
            >
          </div>
          <h1
            class='font-display font-light text-white text-[2.5rem] leading-[1.02] sm:text-5xl lg:text-7xl tracking-[-0.03em] text-balance'>
            Bring us your<br />
            best <em class='not-italic font-normal text-primary-light'
              >question</em
            >.
          </h1>
          <div class='mt-8 h-px w-16 bg-gold/80'></div>
        </div>
        <aside class='lg:col-span-5'>
          <p
            class='text-[15px] sm:text-base text-slate-300 leading-[1.75] max-w-md'>
            We welcome research proposals from academic institutions, government
            agencies, and independent researchers. Start by contacting the
            Research Office with a brief concept note.
          </p>
          <div class='mt-10'>
            <a
              href='mailto:research@spmh.co.ke'
              class='group inline-flex items-center gap-3 pl-6 pr-2 py-2 rounded-full
                      bg-white text-[#0A1730] font-semibold text-sm hover:bg-blue-50 transition-colors shadow-lg shadow-black/30'>
              <span>Email the Research Office</span>
              <span
                class='inline-flex items-center justify-center w-9 h-9 rounded-full bg-[#0A1730] text-white
                           group-hover:translate-x-0.5 transition-transform'>
                <i class='fas fa-arrow-right text-xs' aria-hidden='true'></i>
              </span>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50'>
    <div
      class='max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-y-12 lg:gap-x-16'>
      <div class='lg:col-span-5'>
        <span class='eyebrow'>Requirements</span>
        <h2
          class='mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-secondary text-balance'>
          What your concept note should cover.
        </h2>
        <p class='mt-5 text-base text-slate-600 leading-relaxed'>
          You don&rsquo;t need a full protocol at first. Start with a brief
          concept note &mdash; two to three pages &mdash; addressing these six
          points.
        </p>
        <div class='mt-10 h-px w-16 bg-gold/70'></div>
      </div>
      <div class='lg:col-span-7'>
        <ul class='divide-y divide-slate-100 border-y border-slate-100'>
          {
            requirements.map((r, i) => (
              <li class='py-5 grid grid-cols-1 sm:grid-cols-12 gap-2 sm:gap-4'>
                <span class='sm:col-span-1 font-mono text-xs text-slate-400 pt-1'>
                  {String(i + 1).padStart(2, '0')}
                </span>
                <p class='sm:col-span-4 text-sm font-semibold text-secondary'>
                  {r.title}
                </p>
                <p class='sm:col-span-7 text-sm text-slate-600 leading-relaxed'>
                  {r.detail}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-white'>
    <div class='max-w-7xl mx-auto'>
      <div class='max-w-3xl mb-14'>
        <span class='eyebrow'>What Happens Next</span>
        <h2
          class='mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-secondary text-balance'>
          From concept to collaboration.
        </h2>
      </div>
      <ol class='grid grid-cols-1 md:grid-cols-3 gap-5'>
        {
          [
            {
              n: '01',
              title: 'Initial review',
              detail:
                'We review your concept note within 10 working days and confirm alignment or suggest refinements.',
            },
            {
              n: '02',
              title: 'Full proposal',
              detail:
                'If aligned, we invite a full protocol submission and ethics review.',
            },
            {
              n: '03',
              title: 'Collaboration agreement',
              detail:
                'Once approved, we formalise the collaboration and begin fieldwork.',
            },
          ].map((s) => (
            <li class='rounded-2xl border border-slate-200 bg-white p-6'>
              <span class='font-mono text-xs text-slate-400'>{s.n}</span>
              <h3 class='mt-3 text-lg font-bold text-secondary'>{s.title}</h3>
              <p class='mt-2 text-sm text-slate-600 leading-relaxed'>
                {s.detail}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section
    class='py-20 px-4 sm:px-6 lg:px-8 bg-white border-t border-slate-100'>
    <div class='max-w-3xl mx-auto text-center'>
      <div class='mx-auto h-px w-16 bg-gold/70 mb-10'></div>
      <h2 class='text-3xl sm:text-4xl font-bold text-secondary text-balance'>
        Submit your concept note.
      </h2>
      <p class='mt-5 text-base text-slate-600 leading-relaxed'>
        Email <a
          href='mailto:research@spmh.co.ke'
          class='text-primary hover:underline'>research@spmh.co.ke</a
        >
        with a brief concept note. We&rsquo;ll respond within 10 working days.
      </p>
      <div
        class='mt-10 flex flex-col sm:flex-row justify-center gap-3 sm:gap-4'>
        <a href='mailto:research@spmh.co.ke' class='btn-primary px-6 py-3.5'>
          Email research office <i
            class='fas fa-arrow-right text-xs'
            aria-hidden='true'></i>
        </a>
        <a href='/research/protocols' class='btn-secondary px-6 py-3.5'
          >Templates &amp; guidelines</a
        >
      </div>
    </div>
  </section>
</LandingLayout>
