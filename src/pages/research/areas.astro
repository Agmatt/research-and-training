---
import LandingLayout from '../../layout/LandingLayout.astro';
import BaseHead from '../../components/seo/BaseHead.astro';
import { buildWebPage } from '../../components/seo/schema/webpage';
import { buildBreadcrumbs } from '../../components/seo/schema/breadcrumbs';
import { SITE } from '../../data/site';

const title = 'Research Areas — Four Key Result Areas | SPMH';
const description =
  'Community health, epidemiology, quality improvement, and maternal & child health — the four Key Result Areas guiding research at SPMH.';
const path = '/research/areas';
const canonical = `${SITE.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPage({ title, description, path }),
    buildBreadcrumbs([
      { name: 'Home', item: `${SITE.mainSite.url}/` },
      { name: 'Training & Research', item: `${SITE.url}/` },
      { name: 'Research', item: `${SITE.url}/research` },
      { name: 'Areas', item: `${SITE.url}/research/areas` },
    ]),
  ],
};

const areas = [
  {
    number: '01',
    icon: 'people-group',
    title: 'Community Health',
    summary:
      'CHP-led systems, referral coordination, and continuum-of-care integration within Homa Bay County.',
    objectives: [
      'Assess CHP-led early detection effectiveness',
      'Model referral patterns and continuity of care',
      'Evaluate household-level follow-up on chronic care retention',
      'Study integration between community and facility systems',
    ],
  },
  {
    number: '02',
    icon: 'virus',
    title: 'Epidemiology',
    summary:
      'Communicable and non-communicable disease burden, surveillance, and outbreak preparedness.',
    objectives: [
      'Establish local NCD burden profile',
      'Analyse climate-sensitive disease patterns',
      'Evaluate surveillance improvements feasible at Level 4',
      'Study outbreak preparedness and response readiness',
    ],
  },
  {
    number: '03',
    icon: 'chart-line',
    title: 'Quality Improvement',
    summary:
      'Patient safety, infection prevention, and accreditation-aligned care standards.',
    objectives: [
      'Test IPC interventions on hospital-acquired infection rates',
      'Study clinical audit culture and barriers to reporting',
      'Evaluate QI methodology translation into practice',
      'Assess patient safety culture and incident reporting',
    ],
  },
  {
    number: '04',
    icon: 'baby',
    title: 'Maternal & Child Health',
    summary:
      'Maternal, newborn, child, and adolescent health outcomes with focus on preventable mortality.',
    objectives: [
      'Analyse critical delays in emergency obstetric care',
      'Study neonatal outcomes in the newborn unit',
      'Evaluate adolescent reproductive health service uptake',
      'Assess maternal continuum-of-care integration',
    ],
  },
];
---

<LandingLayout currentPage='Research'>
  <BaseHead
    slot='head'
    title={title}
    description={description}
    canonical={canonical}
    jsonLd={schema}
  />

  <section class='relative bg-[#0A1730] text-white'>
    <div
      class='absolute inset-0 bg-gradient-to-br from-[#0A1730] via-[#0B1E3A] to-[#0E2549]'>
    </div>
    <div
      class='relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-20 pb-16 sm:pt-28 sm:pb-20'>
      <nav aria-label='Breadcrumb' class='mb-12'>
        <ol
          class='flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.24em] font-medium text-slate-500'>
          <li><a href='/' class='hover:text-white'>Home</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li><a href='/research' class='hover:text-white'>Research</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li class='text-gold'>Areas</li>
        </ol>
      </nav>
      <div
        class='grid grid-cols-1 lg:grid-cols-12 gap-y-10 lg:gap-x-10 items-end'>
        <div class='lg:col-span-7'>
          <div class='flex items-center gap-4 mb-6'>
            <span class='h-px w-12 bg-gold/70'></span>
            <span
              class='text-[10px] sm:text-xs font-semibold uppercase tracking-[0.24em] text-gold'
              >Key Result Areas</span
            >
          </div>
          <h1
            class='font-display font-light text-white text-[2.5rem] leading-[1.02] sm:text-5xl lg:text-7xl tracking-[-0.03em] text-balance'>
            Four lines<br />
            of <em class='not-italic font-normal text-primary-light'>inquiry</em
            >.
          </h1>
          <div class='mt-8 h-px w-16 bg-gold/80'></div>
        </div>
        <aside class='lg:col-span-5'>
          <p
            class='text-[15px] sm:text-base text-slate-300 leading-[1.75] max-w-md'>
            Our research agenda is organised around four Key Result Areas. Each
            one addresses a real clinical, operational, or public health
            question within our catchment.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50'>
    <div class='max-w-7xl mx-auto space-y-6'>
      {
        areas.map((a) => (
          <article class='rounded-2xl border border-slate-200 bg-white overflow-hidden'>
            <div class='grid grid-cols-1 lg:grid-cols-12'>
              <div class='lg:col-span-4 p-6 sm:p-8 border-b lg:border-b-0 lg:border-r border-slate-100'>
                <span class='font-mono text-xs text-slate-400'>{a.number}</span>
                <div class='w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mt-4 mb-5'>
                  <i class={`fas fa-${a.icon} text-lg`} aria-hidden='true' />
                </div>
                <h2 class='text-2xl font-bold text-secondary'>{a.title}</h2>
                <p class='mt-3 text-sm text-slate-600 leading-relaxed'>
                  {a.summary}
                </p>
              </div>
              <div class='lg:col-span-8 p-6 sm:p-8'>
                <p class='text-[10px] font-semibold uppercase tracking-[0.22em] text-slate-400 mb-4'>
                  Research Objectives
                </p>
                <ul class='space-y-3'>
                  {a.objectives.map((o) => (
                    <li class='flex gap-3 text-sm text-slate-700 leading-relaxed'>
                      <span class='shrink-0 mt-1.5 h-1.5 w-1.5 rounded-full bg-primary' />
                      <span>{o}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class='py-20 px-4 sm:px-6 lg:px-8 bg-white border-t border-slate-100'>
    <div class='max-w-3xl mx-auto text-center'>
      <div class='mx-auto h-px w-16 bg-gold/70 mb-10'></div>
      <h2 class='text-3xl sm:text-4xl font-bold text-secondary text-balance'>
        Have a proposal?
      </h2>
      <p class='mt-5 text-base text-slate-600 leading-relaxed'>
        If your research extends any of these lines of inquiry, we want to hear
        from you.
      </p>
      <div
        class='mt-10 flex flex-col sm:flex-row justify-center gap-3 sm:gap-4'>
        <a href='/research/propose' class='btn-primary px-6 py-3.5'>
          Propose a project <i
            class='fas fa-arrow-right text-xs'
            aria-hidden='true'></i>
        </a>
        <a href='/research/ethics' class='btn-secondary px-6 py-3.5'
          >Ethics process</a
        >
      </div>
    </div>
  </section>
</LandingLayout>
