---
import LandingLayout from '../../layout/LandingLayout.astro';
import BaseHead from '../../components/seo/BaseHead.astro';
import { buildWebPage } from '../../components/seo/schema/webpage';
import { buildBreadcrumbs } from '../../components/seo/schema/breadcrumbs';
import { SITE } from '../../data/site';

const title = 'MOU Framework & Template — Partnerships | SPMH';
const description =
  'Our standard memorandum of understanding framework for academic and institutional partnerships.';
const path = '/collaborate/mou';
const canonical = `${SITE.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPage({ title, description, path }),
    buildBreadcrumbs([
      { name: 'Home', item: `${SITE.mainSite.url}/` },
      { name: 'Training & Research', item: `${SITE.url}/` },
      { name: 'Collaborate', item: `${SITE.url}/collaborate` },
      { name: 'MOU', item: `${SITE.url}/collaborate/mou` },
    ]),
  ],
};

const sections = [
  {
    title: 'Purpose & Scope',
    detail: 'What the partnership covers, and what it explicitly does not.',
  },
  {
    title: 'Duration & Renewal',
    detail: 'Standard term, renewal clauses, and termination conditions.',
  },
  {
    title: 'Roles & Responsibilities',
    detail: 'Clear delineation of what each party commits to.',
  },
  {
    title: 'Financial Arrangements',
    detail: 'Any cost-sharing, reimbursement, or funding arrangements.',
  },
  {
    title: 'Data Handling & Privacy',
    detail:
      'Compliance with Kenya Data Protection Act and institutional protocols.',
  },
  {
    title: 'Intellectual Property',
    detail: 'Ownership of outputs, publications, and derived materials.',
  },
  {
    title: 'Ethics & Compliance',
    detail: 'Alignment with professional ethics and Catholic Social Teaching.',
  },
  {
    title: 'Dispute Resolution',
    detail: 'Governance, escalation, and resolution mechanisms.',
  },
  {
    title: 'Signatories',
    detail: 'The authorised representatives of each party.',
  },
];

const process = [
  {
    step: '01',
    title: 'Initial inquiry',
    detail: 'Submit your partnership interest via our inquiry form.',
  },
  {
    step: '02',
    title: 'Scoping call',
    detail:
      'We schedule a discussion to align on scope, timelines, and mutual expectations.',
  },
  {
    step: '03',
    title: 'Draft review',
    detail:
      'We share a draft MOU using our template. Your institution reviews and proposes edits.',
  },
  {
    step: '04',
    title: 'Legal review',
    detail: 'Both parties conduct legal and governance review.',
  },
  {
    step: '05',
    title: 'Signing',
    detail: 'MOU is signed by authorised representatives of both institutions.',
  },
];
---

<LandingLayout currentPage='Collaborate'>
  <BaseHead
    slot='head'
    title={title}
    description={description}
    canonical={canonical}
    jsonLd={schema}
  />

  <section class='relative bg-[#0A1730] text-white'>
    <div
      class='absolute inset-0 bg-gradient-to-br from-[#0A1730] via-[#0B1E3A] to-[#0E2549]'>
    </div>
    <div
      class='relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-20 pb-16 sm:pt-28 sm:pb-20'>
      <nav aria-label='Breadcrumb' class='mb-12'>
        <ol
          class='flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.24em] font-medium text-slate-500'>
          <li><a href='/' class='hover:text-white'>Home</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li>
            <a href='/collaborate' class='hover:text-white'>Collaborate</a>
          </li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li class='text-gold'>MOU</li>
        </ol>
      </nav>
      <div
        class='grid grid-cols-1 lg:grid-cols-12 gap-y-10 lg:gap-x-10 items-end'>
        <div class='lg:col-span-7'>
          <div class='flex items-center gap-4 mb-6'>
            <span class='h-px w-12 bg-gold/70'></span>
            <span
              class='text-[10px] sm:text-xs font-semibold uppercase tracking-[0.24em] text-gold'
              >Framework</span
            >
          </div>
          <h1
            class='font-display font-light text-white text-[2.5rem] leading-[1.02] sm:text-5xl lg:text-7xl tracking-[-0.03em] text-balance'>
            Structured.<br />
            Documented. <em class='not-italic font-normal text-primary-light'
              >Durable</em
            >.
          </h1>
          <div class='mt-8 h-px w-16 bg-gold/80'></div>
        </div>
        <aside class='lg:col-span-5'>
          <p
            class='text-[15px] sm:text-base text-slate-300 leading-[1.75] max-w-md'>
            Our MOU framework is designed to make partnerships transparent and
            enforceable. This is what our standard agreement covers, and how the
            process works end to end.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50'>
    <div class='max-w-7xl mx-auto'>
      <div class='max-w-3xl mb-14'>
        <span class='eyebrow'>What It Covers</span>
        <h2
          class='mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-secondary text-balance'>
          Nine sections.
        </h2>
        <p class='mt-5 text-base sm:text-lg text-slate-600 leading-relaxed'>
          Our standard MOU template addresses the following. Sections are
          adapted to your specific partnership type.
        </p>
      </div>
      <ul class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4'>
        {
          sections.map((s, i) => (
            <li class='rounded-xl border border-slate-200 bg-white p-5'>
              <span class='font-mono text-xs text-slate-400'>0{i + 1}</span>
              <h3 class='mt-2 text-sm font-bold text-secondary'>{s.title}</h3>
              <p class='mt-1.5 text-xs text-slate-600 leading-relaxed'>
                {s.detail}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-white'>
    <div class='max-w-7xl mx-auto'>
      <div class='max-w-3xl mb-14'>
        <span class='eyebrow'>The Process</span>
        <h2
          class='mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-secondary text-balance'>
          From inquiry to signing.
        </h2>
        <p class='mt-5 text-base sm:text-lg text-slate-600 leading-relaxed'>
          The typical MOU process takes 4&ndash;8 weeks, depending on
          institutional review cycles.
        </p>
      </div>
      <ol class='relative space-y-6'>
        <span
          class='hidden md:block absolute left-[27px] top-4 bottom-4 w-px bg-slate-200'
          aria-hidden='true'></span>
        {
          process.map((p) => (
            <li class='relative md:pl-20'>
              <div class='hidden md:flex absolute left-0 top-2 w-14 h-14 rounded-full bg-white border border-slate-200 items-center justify-center font-mono text-sm text-primary'>
                {p.step}
              </div>
              <div class='rounded-2xl border border-slate-200 bg-white p-6'>
                <h3 class='text-lg font-bold text-secondary mb-2'>{p.title}</h3>
                <p class='text-sm text-slate-600 leading-relaxed'>{p.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div
        class='mt-14 flex flex-col sm:flex-row gap-4 items-start sm:items-center p-6 rounded-2xl bg-slate-50 border border-slate-200'>
        <i class='fas fa-file-pdf text-3xl text-primary' aria-hidden='true'></i>
        <div class='flex-1'>
          <h3 class='text-base font-bold text-secondary'>MOU Template</h3>
          <p class='text-sm text-slate-600 mt-0.5'>
            Download the standard template for review.
          </p>
        </div>
        <a
          href='/files/mou-template.pdf'
          download
          class='btn-primary px-5 py-2.5'>
          <i class='fas fa-download text-xs' aria-hidden='true'></i>
          Download
        </a>
      </div>
    </div>
  </section>

  <section
    class='py-20 px-4 sm:px-6 lg:px-8 bg-white border-t border-slate-100'>
    <div class='max-w-3xl mx-auto text-center'>
      <div class='mx-auto h-px w-16 bg-gold/70 mb-10'></div>
      <h2 class='text-3xl sm:text-4xl font-bold text-secondary text-balance'>
        Ready to draft an MOU?
      </h2>
      <p class='mt-5 text-base text-slate-600 leading-relaxed'>
        Start with an inquiry &mdash; we&rsquo;ll take it from there.
      </p>
      <div
        class='mt-10 flex flex-col sm:flex-row justify-center gap-3 sm:gap-4'>
        <a href='/collaborate/inquiry' class='btn-primary px-6 py-3.5'>
          Start inquiry <i class='fas fa-arrow-right text-xs' aria-hidden='true'
          ></i>
        </a>
        <a
          href='mailto:partnerships@spmh.co.ke'
          class='btn-secondary px-6 py-3.5'>Email partnerships</a
        >
      </div>
    </div>
  </section>
</LandingLayout>
