---
import LandingLayout from '../../layout/LandingLayout.astro';
import BaseHead from '../../components/seo/BaseHead.astro';
import { buildWebPage } from '../../components/seo/schema/webpage';
import { buildBreadcrumbs } from '../../components/seo/schema/breadcrumbs';
import { SITE } from '../../data/site';

const title = 'Collaborate — Partnerships with SPMH Homa Bay';
const description =
  "Build sustainable partnerships with St. Paul's Mission Hospital — student pipelines, joint research, faculty exchange, and formal MOUs.";
const path = '/collaborate';
const canonical = `${SITE.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPage({ title, description, path }),
    buildBreadcrumbs([
      { name: 'Home', item: `${SITE.mainSite.url}/` },
      { name: 'Training & Research', item: `${SITE.url}/` },
      { name: 'Collaborate', item: `${SITE.url}/collaborate` },
    ]),
  ],
};

const paths = [
  {
    icon: 'handshake',
    title: 'Partnership Inquiry',
    summary:
      'Start a conversation about partnership. Response within 48 hours.',
    href: '/collaborate/inquiry',
  },
  {
    icon: 'file-contract',
    title: 'MOU Framework',
    summary: 'Our standard memorandum of understanding and what it covers.',
    href: '/collaborate/mou',
  },
  {
    icon: 'building',
    title: 'Partner Directory',
    summary:
      'Academic, health system, and development partners working with SPMH.',
    href: '/collaborate/directory',
  },
];

const benefits = [
  'Structured student attachment pipelines aligned with your curriculum',
  'Joint research initiatives in community and rural health',
  'Faculty exchange and CME programme collaboration',
  'Formal international institutional agreements',
  'Access to a catchment of ~250,000 in Western Kenya',
  'Alignment with Kenya UHC, WHO standards, and Catholic Social Teaching',
];
---

<LandingLayout currentPage='Collaborate'>
  <BaseHead
    slot='head'
    title={title}
    description={description}
    canonical={canonical}
    jsonLd={schema}
  />

  <section class='relative overflow-hidden bg-[#0A1730] text-white'>
    <div
      class='absolute inset-0 bg-gradient-to-br from-[#0A1730] via-[#0B1E3A] to-[#0E2549]'>
    </div>
    <div
      class='relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-20 pb-16 sm:pt-28 sm:pb-24'>
      <nav aria-label='Breadcrumb' class='mb-12'>
        <ol
          class='flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.24em] font-medium text-slate-500'>
          <li><a href='/' class='hover:text-white'>Home</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li class='text-gold'>Collaborate</li>
        </ol>
      </nav>
      <div
        class='grid grid-cols-1 lg:grid-cols-12 gap-y-10 lg:gap-x-10 items-end'>
        <div class='lg:col-span-7'>
          <div class='flex items-center gap-4 mb-6'>
            <span class='h-px w-12 bg-gold/70'></span>
            <span
              class='text-[10px] sm:text-xs font-semibold uppercase tracking-[0.24em] text-gold'
              >Institutional Collaboration</span
            >
          </div>
          <h1
            class='font-display font-light text-white text-[2.5rem] leading-[1.02] sm:text-5xl lg:text-7xl xl:text-[5rem] tracking-[-0.03em] text-balance'>
            Partnerships that<br />
            <em class='not-italic font-normal text-primary-light'>outlast</em> the
            moment.
          </h1>
          <div class='mt-8 h-px w-16 bg-gold/80'></div>
        </div>
        <aside class='lg:col-span-5'>
          <p
            class='text-[15px] sm:text-base text-slate-300 leading-[1.75] max-w-md'>
            From single student placements to standing MOUs covering teaching,
            research, and faculty exchange &mdash; we build partnerships that
            are documented, measurable, and durable.
          </p>
          <div class='mt-10 flex flex-wrap gap-3'>
            <a
              href='/collaborate/inquiry'
              class='group inline-flex items-center gap-3 pl-6 pr-2 py-2 rounded-full
                      bg-white text-[#0A1730] font-semibold text-sm hover:bg-blue-50 transition-colors shadow-lg shadow-black/30'>
              <span>Start a conversation</span>
              <span
                class='inline-flex items-center justify-center w-9 h-9 rounded-full bg-[#0A1730] text-white group-hover:translate-x-0.5 transition-transform'>
                <i class='fas fa-arrow-right text-xs' aria-hidden='true'></i>
              </span>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50'>
    <div class='max-w-7xl mx-auto'>
      <div class='grid grid-cols-1 md:grid-cols-3 gap-6'>
        {
          paths.map((p) => (
            <a
              href={p.href}
              class='group flex flex-col rounded-2xl border border-slate-200 bg-white p-8
                     hover:-translate-y-1 hover:shadow-xl hover:border-blue-200 transition-all'>
              <div
                class='w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-5
                        group-hover:bg-primary group-hover:text-white transition-colors'>
                <i class={`fas fa-${p.icon} text-lg`} aria-hidden='true' />
              </div>
              <h3 class='text-lg font-bold text-secondary'>{p.title}</h3>
              <p class='mt-3 text-sm text-slate-600 leading-relaxed flex-1'>
                {p.summary}
              </p>
              <span class='mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary group-hover:gap-3 transition-all'>
                Learn more{' '}
                <i class='fas fa-arrow-right text-xs' aria-hidden='true' />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-white'>
    <div
      class='max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-y-12 lg:gap-x-16'>
      <div class='lg:col-span-5'>
        <span class='eyebrow'>What You Get</span>
        <h2
          class='mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-secondary text-balance'>
          The partnership proposition.
        </h2>
        <p class='mt-5 text-base text-slate-600 leading-relaxed'>
          Every partnership is different, but the benefits tend to fall into six
          categories. We&rsquo;ll shape the specifics together.
        </p>
        <div class='mt-10 h-px w-16 bg-gold/70'></div>
      </div>
      <div class='lg:col-span-7'>
        <ul class='divide-y divide-slate-100 border-y border-slate-100'>
          {
            benefits.map((b, i) => (
              <li class='py-5 flex gap-4'>
                <span class='font-mono text-xs text-slate-400 pt-1'>
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class='text-sm sm:text-base text-slate-700 leading-relaxed'>
                  {b}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section
    class='py-20 px-4 sm:px-6 lg:px-8 bg-white border-t border-slate-100'>
    <div class='max-w-3xl mx-auto text-center'>
      <div class='mx-auto h-px w-16 bg-gold/70 mb-10'></div>
      <h2 class='text-3xl sm:text-4xl font-bold text-secondary text-balance'>
        Let&rsquo;s discuss what partnership looks like.
      </h2>
      <p class='mt-5 text-base text-slate-600 leading-relaxed'>
        Tell us about your institution. We&rsquo;ll respond within 48 hours.
      </p>
      <div
        class='mt-10 flex flex-col sm:flex-row justify-center gap-3 sm:gap-4'>
        <a href='/collaborate/inquiry' class='btn-primary px-6 py-3.5'>
          Start inquiry <i class='fas fa-arrow-right text-xs' aria-hidden='true'
          ></i>
        </a>
        <a
          href='mailto:partnerships@spmh.co.ke'
          class='btn-secondary px-6 py-3.5'>Email partnerships</a
        >
      </div>
    </div>
  </section>
</LandingLayout>
