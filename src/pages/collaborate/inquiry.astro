---
import LandingLayout from '../../layout/LandingLayout.astro';
import BaseHead from '../../components/seo/BaseHead.astro';
import { buildWebPage } from '../../components/seo/schema/webpage';
import { buildBreadcrumbs } from '../../components/seo/schema/breadcrumbs';
import PartnershipInquiryForm from '../../components/forms/PartnershipInquiryForm.jsx';
import { SITE } from '../../data/site';

const title = 'Partnership Inquiry — SPMH Homa Bay';
const description =
  'Tell us about your institution and partnership interests. We respond within 48 hours.';
const path = '/collaborate/inquiry';
const canonical = `${SITE.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPage({ title, description, path }),
    buildBreadcrumbs([
      { name: 'Home', item: `${SITE.mainSite.url}/` },
      { name: 'Training & Research', item: `${SITE.url}/` },
      { name: 'Collaborate', item: `${SITE.url}/collaborate` },
      { name: 'Inquiry', item: `${SITE.url}/collaborate/inquiry` },
    ]),
  ],
};
---

<LandingLayout currentPage='Collaborate'>
  <BaseHead
    slot='head'
    title={title}
    description={description}
    canonical={canonical}
    jsonLd={schema}
  />

  <section class='relative bg-[#0A1730] text-white'>
    <div
      class='absolute inset-0 bg-gradient-to-br from-[#0A1730] via-[#0B1E3A] to-[#0E2549]'>
    </div>
    <div
      class='relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-16 sm:py-20'>
      <nav aria-label='Breadcrumb' class='mb-8'>
        <ol
          class='flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.24em] font-medium text-slate-500'>
          <li><a href='/' class='hover:text-white'>Home</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li>
            <a href='/collaborate' class='hover:text-white'>Collaborate</a>
          </li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li class='text-gold'>Inquiry</li>
        </ol>
      </nav>
      <h1
        class='font-display font-light text-white text-4xl sm:text-5xl lg:text-6xl tracking-[-0.03em] text-balance max-w-3xl'>
        Let&rsquo;s talk.
      </h1>
      <p class='mt-6 text-base sm:text-lg text-slate-300 max-w-xl'>
        Tell us about your institution and partnership interests. We&rsquo;ll
        get back to you within 48 hours on business days.
      </p>
    </div>
  </section>

  <section class='py-16 sm:py-20 px-4 sm:px-6 lg:px-8 bg-slate-100'>
    <div class='max-w-3xl mx-auto'>
      <div
        class='bg-gradient-to-br from-slate-800 to-slate-900 rounded-3xl border border-slate-700/50 shadow-2xl overflow-hidden'>
        <div class='px-8 py-6'>
          <h2 class='text-white text-xl font-bold'>
            Institutional Partnership Form
          </h2>
          <p class='text-blue-100 text-sm mt-1'>
            We look forward to collaborating with you.
          </p>
        </div>
        <div class='p-6 sm:p-10'>
          <PartnershipInquiryForm client:load />
        </div>
      </div>
    </div>
  </section>
</LandingLayout>
