---
import BaseHead from '../../components/seo/BaseHead.astro';
import SetPasswordPage from '../../components/admin/auth/SetPasswordPage.jsx';
import { SITE } from '../../data/site';
import '../../styles/global.css';

const title = 'Set your password — SPMH';
const canonical = `${SITE.url}/admin/set-password`;
---

<!doctype html>
<html lang='en-KE' class='scroll-smooth'>
  <head>
    <BaseHead
      title={title}
      description='Set your account password.'
      canonical={canonical}
      noindex={true}
    />
  </head>
  <body class='antialiased'>
    <SetPasswordPage client:load />
  </body>
</html>
