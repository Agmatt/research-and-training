---
import BaseHead from '../../../components/seo/BaseHead.astro';
import AdminPage from '../../../components/admin/AdminPage.jsx';
import SettingsPage from '../../../components/admin/settings/SettingsPage.jsx';
import { SITE } from '../../../data/site';
import '../../../styles/global.css';

const title = 'Settings — SPMH Admin';
const canonical = `${SITE.url}/admin/academics/settings`;
---

<!doctype html>
<html lang='en-KE' class='scroll-smooth'>
  <head>
    <BaseHead
      title={title}
      description='Account and team settings.'
      canonical={canonical}
      noindex={true}
    />
  </head>
  <body class='antialiased'>
    <AdminPage
      client:load
      currentPath='/admin/academics/settings'
      pageTitle='Settings'>
      <SettingsPage client:load />
    </AdminPage>
  </body>
</html>
