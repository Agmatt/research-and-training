---
import BaseHead from '../../../components/seo/BaseHead.astro';
import AdminPage from '../../../components/admin/AdminPage.jsx';
import PartnershipsPage from '../../../components/admin/partnerships/PartnershipsPage.jsx';
import { SITE } from '../../../data/site';
import '../../../styles/global.css';

const title = 'Partnerships — SPMH Admin';
const canonical = `${SITE.url}/admin/academics/partnerships`;
---

<!doctype html>
<html lang='en-KE' class='scroll-smooth'>
  <head>
    <BaseHead
      title={title}
      description='Partnership inquiry management.'
      canonical={canonical}
      noindex={true}
    />
  </head>
  <body class='antialiased'>
    <AdminPage
      client:load
      currentPath='/admin/academics/partnerships'
      pageTitle='Partnerships'>
      <PartnershipsPage client:load />
    </AdminPage>
  </body>
</html>
