---
import BaseHead from '../../../components/seo/BaseHead.astro';
import AdminPage from '../../../components/admin/AdminPage.jsx';
import ApplicantsPage from '../../../components/admin/applicants/ApplicantsPage.jsx';
import { SITE } from '../../../data/site';
import '../../../styles/global.css';

const title = 'Applicants — SPMH Admin';
const canonical = `${SITE.url}/admin/academics/applicants`;
---

<!doctype html>
<html lang='en-KE' class='scroll-smooth'>
  <head>
    <BaseHead
      title={title}
      description='Applicant management.'
      canonical={canonical}
      noindex={true}
    />
  </head>
  <body class='antialiased'>
    <AdminPage
      client:load
      currentPath='/admin/academics/applicants'
      pageTitle='Applicants'>
      <ApplicantsPage client:load />
    </AdminPage>
  </body>
</html>
