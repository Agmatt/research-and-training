---
import BaseHead from '../../../components/seo/BaseHead.astro';
import AdminPage from '../../../components/admin/AdminPage.jsx';
import SupervisorsPage from '../../../components/admin/supervisors/SupervisorsPage.jsx';
import { SITE } from '../../../data/site';
import '../../../styles/global.css';

const title = 'Supervisors — SPMH Admin';
const canonical = `${SITE.url}/admin/academics/supervisors`;
---

<!doctype html>
<html lang='en-KE' class='scroll-smooth'>
  <head>
    <BaseHead
      title={title}
      description='Supervisor and preceptor tools.'
      canonical={canonical}
      noindex={true}
    />
  </head>
  <body class='antialiased'>
    <AdminPage
      client:load
      currentPath='/admin/academics/supervisors'
      pageTitle='Supervisors'>
      <SupervisorsPage client:load />
    </AdminPage>
  </body>
</html>
