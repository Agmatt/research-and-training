---
import LandingLayout from '../../layout/LandingLayout.astro';
import BaseHead from '../../components/seo/BaseHead.astro';
import { buildWebPage } from '../../components/seo/schema/webpage';
import { buildBreadcrumbs } from '../../components/seo/schema/breadcrumbs';
import { SITE } from '../../data/site';

const title =
  'Apply — Clinical Attachment, Internship & Community Health | SPMH';
const description =
  "Apply for clinical attachment, internship, or community health training at St. Paul's Mission Hospital, Homa Bay. Structured programmes for students and health professionals.";
const path = '/apply';
const canonical = `${SITE.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPage({ title, description, path }),
    buildBreadcrumbs([
      { name: 'Home', item: `${SITE.mainSite.url}/` },
      { name: 'Training & Research', item: `${SITE.url}/` },
      { name: 'Apply', item: `${SITE.url}/apply` },
    ]),
  ],
};

const programmes = [
  {
    icon: 'heart-pulse',
    title: 'Clinical Attachment',
    duration: '6–12 weeks',
    summary:
      'Structured rotations across nursing, laboratory, pharmacy, and outpatient departments under certified preceptors.',
    href: '/apply/clinical',
  },
  {
    icon: 'graduation-cap',
    title: 'Internship',
    duration: '12 months',
    summary:
      'Structured internship placements for clinical officers, nurses, and selected allied health cadres.',
    href: '/apply/internship',
  },
  {
    icon: 'people-group',
    title: 'Community Health',
    duration: '4–12 weeks',
    summary:
      'Field-based training with CHP-led systems and public health programmes across Homa Bay County.',
    href: '/apply/community-health',
  },
];
---

<LandingLayout currentPage='Apply'>
  <BaseHead
    slot='head'
    title={title}
    description={description}
    canonical={canonical}
    jsonLd={schema}
  />

  <section class='relative overflow-hidden bg-[#0A1730] text-white'>
    <div
      class='absolute inset-0 bg-gradient-to-br from-[#0A1730] via-[#0B1E3A] to-[#0E2549]'>
    </div>
    <div
      class='relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-20 pb-16 sm:pt-28 sm:pb-24'>
      <nav aria-label='Breadcrumb' class='mb-12'>
        <ol
          class='flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.24em] font-medium text-slate-500'>
          <li>
            <a href='/' class='hover:text-white transition-colors'>Home</a>
          </li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li class='text-gold'>Apply</li>
        </ol>
      </nav>

      <div
        class='grid grid-cols-1 lg:grid-cols-12 gap-y-10 lg:gap-x-10 items-end'>
        <div class='lg:col-span-7'>
          <div class='flex items-center gap-4 mb-6'>
            <span class='h-px w-12 bg-gold/70'></span>
            <span
              class='text-[10px] sm:text-xs font-semibold uppercase tracking-[0.24em] text-gold'>
              Application Hub
            </span>
          </div>
          <h1
            class='font-display font-light text-white text-[2.5rem] leading-[1.02] sm:text-5xl lg:text-7xl xl:text-[5rem] tracking-[-0.03em] text-balance'>
            Choose your<br />
            <em class='not-italic font-normal text-primary-light'>pathway</em>.
          </h1>
          <div class='mt-8 h-px w-16 bg-gold/80'></div>
        </div>
        <aside class='lg:col-span-5'>
          <p
            class='text-[15px] sm:text-base text-slate-300 leading-[1.75] max-w-md'>
            Three structured programmes for students and health professionals.
            Each one comes with certified preceptors, real clinical exposure,
            and a formal certificate on completion.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50'>
    <div class='max-w-7xl mx-auto'>
      <div class='grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-7'>
        {
          programmes.map((p) => (
            <a
              href={p.href}
              class='group flex flex-col rounded-2xl border border-slate-200 bg-white p-8
                    hover:-translate-y-1 hover:shadow-xl hover:border-blue-200 transition-all'>
              <div class='flex items-center justify-between mb-6'>
                <div
                  class='w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center
                          group-hover:bg-primary group-hover:text-white transition-colors'>
                  <i class={`fas fa-${p.icon} text-lg`} aria-hidden='true' />
                </div>
                <span class='text-[10px] font-semibold uppercase tracking-wider text-slate-400'>
                  {p.duration}
                </span>
              </div>
              <h3 class='text-xl font-bold text-secondary'>{p.title}</h3>
              <p class='mt-3 text-sm text-slate-600 leading-relaxed flex-1'>
                {p.summary}
              </p>
              <span class='mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary group-hover:gap-3 transition-all'>
                Learn more{' '}
                <i class='fas fa-arrow-right text-xs' aria-hidden='true' />
              </span>
            </a>
          ))
        }
      </div>

      <div
        class='mt-14 rounded-2xl bg-slate-900 text-white p-8 sm:p-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6'>
        <div>
          <h3 class='text-2xl font-bold text-white'>Ready to apply now?</h3>
          <p class='mt-2 text-slate-300'>
            One form. Three programmes. Response within 3–5 working days.
          </p>
        </div>
        <a href='/apply/form' class='btn-primary px-6 py-3.5 shrink-0'>
          Go to application <i
            class='fas fa-arrow-right text-xs'
            aria-hidden='true'></i>
        </a>
      </div>
    </div>
  </section>
</LandingLayout>
