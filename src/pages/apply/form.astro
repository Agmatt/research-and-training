---
import LandingLayout from '../../layout/LandingLayout.astro';
import BaseHead from '../../components/seo/BaseHead.astro';
import { buildWebPage } from '../../components/seo/schema/webpage';
import { buildBreadcrumbs } from '../../components/seo/schema/breadcrumbs';
import StudentAttachmentForm from '../../components/forms/StudentAttachmentForm.jsx';
import { SITE } from '../../data/site';

const title = 'Apply — Online Application Form | SPMH Homa Bay';
const description =
  'Submit your clinical attachment or internship application online. Response within 3–5 working days.';
const path = '/apply/form';
const canonical = `${SITE.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPage({ title, description, path }),
    buildBreadcrumbs([
      { name: 'Home', item: `${SITE.mainSite.url}/` },
      { name: 'Training & Research', item: `${SITE.url}/` },
      { name: 'Apply', item: `${SITE.url}/apply` },
      { name: 'Application Form', item: `${SITE.url}/apply/form` },
    ]),
  ],
};
---

<LandingLayout currentPage='Apply'>
  <BaseHead
    slot='head'
    title={title}
    description={description}
    canonical={canonical}
    jsonLd={schema}
  />

  <section class='relative bg-[#0A1730] text-white'>
    <div
      class='absolute inset-0 bg-gradient-to-br from-[#0A1730] via-[#0B1E3A] to-[#0E2549]'>
    </div>
    <div
      class='relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-16 sm:py-20'>
      <nav aria-label='Breadcrumb' class='mb-8'>
        <ol
          class='flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.24em] font-medium text-slate-500'>
          <li><a href='/' class='hover:text-white'>Home</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li><a href='/apply' class='hover:text-white'>Apply</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li class='text-gold'>Form</li>
        </ol>
      </nav>
      <h1
        class='font-display font-light text-white text-4xl sm:text-5xl lg:text-6xl tracking-[-0.03em] text-balance max-w-3xl'>
        Application form.
      </h1>
      <p class='mt-6 text-base sm:text-lg text-slate-300 max-w-xl'>
        About 15 minutes to complete. You&rsquo;ll receive a reference code on
        submission and hear from HR within 3&ndash;5 working days.
      </p>
    </div>
  </section>

  <section class='py-16 sm:py-20 px-4 sm:px-6 lg:px-8 bg-slate-50'>
    <div class='max-w-4xl mx-auto'>
      <div
        class='bg-white rounded-3xl border border-slate-200 shadow-lg overflow-hidden'>
        <div class='bg-primary px-8 py-6'>
          <h2 class='text-white text-xl font-bold'>
            Clinical Attachment &amp; Internship Application
          </h2>
          <p class='text-blue-100 text-sm mt-1'>
            All fields marked with * are required.
          </p>
        </div>
        <div class='p-6 sm:p-10'>
          <StudentAttachmentForm client:load />
        </div>
      </div>

      <p class='mt-6 text-center text-xs text-slate-500'>
        By submitting this form you agree to our
        <a href='/terms-of-attachment' class='text-primary hover:underline'
          > terms of attachment</a
        >.
      </p>
    </div>
  </section>
</LandingLayout>
