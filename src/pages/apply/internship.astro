---
import LandingLayout from '../../layout/LandingLayout.astro';
import BaseHead from '../../components/seo/BaseHead.astro';
import { buildWebPage } from '../../components/seo/schema/webpage';
import { buildBreadcrumbs } from '../../components/seo/schema/breadcrumbs';
import { SITE } from '../../data/site';

const title = 'Internship Programme — Clinical Officers & Allied Health | SPMH';
const description =
  "Structured 12-month internship placements for clinical officers, nurses, and selected allied health cadres at St. Paul's Mission Hospital, Homa Bay.";
const path = '/apply/internship';
const canonical = `${SITE.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPage({ title, description, path }),
    buildBreadcrumbs([
      { name: 'Home', item: `${SITE.mainSite.url}/` },
      { name: 'Training & Research', item: `${SITE.url}/` },
      { name: 'Apply', item: `${SITE.url}/apply` },
      { name: 'Internship', item: `${SITE.url}/apply/internship` },
    ]),
  ],
};

const cadres = [
  {
    icon: 'user-doctor',
    title: 'Clinical Officers',
    duration: '12 months',
    note: 'Rotating across OPD, IPD, A&E, and specialty clinics.',
  },
  {
    icon: 'user-nurse',
    title: 'Nursing Officers',
    duration: '12 months',
    note: 'Ward rotations with structured preceptorship and audit.',
  },
  {
    icon: 'flask-vial',
    title: 'Medical Laboratory',
    duration: '12 months',
    note: 'Full-spectrum diagnostics including quality assurance.',
  },
  {
    icon: 'prescription-bottle-medical',
    title: 'Pharmacy',
    duration: '12 months',
    note: 'Dispensing, inventory, clinical pharmacy, and pharmacovigilance.',
  },
];

const competencies = [
  {
    title: 'Clinical Decision-Making',
    detail:
      'Structured case reviews, morbidity and mortality meetings, and weekly preceptor feedback.',
  },
  {
    title: 'Emergency Response',
    detail:
      'Regular simulation drills for obstetric, paediatric, and medical emergencies.',
  },
  {
    title: 'Patient Safety',
    detail:
      'IPC protocols, medication safety, and incident reporting integrated into daily practice.',
  },
  {
    title: 'Digital Literacy',
    detail:
      'Full EMR operation, digital documentation, and clinical decision support tools.',
  },
  {
    title: 'Ethics & Professionalism',
    detail:
      'Grounded in Catholic Social Teaching and professional healthcare ethics.',
  },
  {
    title: 'Leadership Foundation',
    detail: 'Exposure to ward management, audit cycles, and team coordination.',
  },
];

const pathway = [
  {
    phase: 'Phase 1',
    period: '2026–2027',
    status: 'Structured attachments and selected internship placements',
  },
  {
    phase: 'Phase 2',
    period: '2028–2029',
    status:
      'Formal accreditation pathway initiated; expanded placement capacity',
  },
  {
    phase: 'Phase 3',
    period: '2030',
    status: 'Accredited internship training hospital status',
  },
];
---

<LandingLayout currentPage='Apply'>
  <BaseHead
    slot='head'
    title={title}
    description={description}
    canonical={canonical}
    jsonLd={schema}
  />

  <!-- HERO -->
  <section class='relative overflow-hidden bg-[#0A1730] text-white'>
    <div
      class='absolute inset-0 bg-gradient-to-br from-[#0A1730] via-[#0B1E3A] to-[#0E2549]'>
    </div>
    <div
      class='relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-20 pb-16 sm:pt-28 sm:pb-24'>
      <nav aria-label='Breadcrumb' class='mb-12'>
        <ol
          class='flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.24em] font-medium text-slate-500'>
          <li><a href='/' class='hover:text-white'>Home</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li><a href='/apply' class='hover:text-white'>Apply</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li class='text-gold'>Internship</li>
        </ol>
      </nav>
      <div
        class='grid grid-cols-1 lg:grid-cols-12 gap-y-10 lg:gap-x-10 items-end'>
        <div class='lg:col-span-7'>
          <div class='flex items-center gap-4 mb-6'>
            <span class='h-px w-12 bg-gold/70'></span>
            <span
              class='text-[10px] sm:text-xs font-semibold uppercase tracking-[0.24em] text-gold'
              >Level 5 Pipeline</span
            >
          </div>
          <h1
            class='font-display font-light text-white text-[2.5rem] leading-[1.02] sm:text-5xl lg:text-7xl xl:text-[5rem] tracking-[-0.03em] text-balance'>
            Twelve months<br />
            that shape a <em class='not-italic font-normal text-primary-light'
              >career</em
            >.
          </h1>
          <div class='mt-8 h-px w-16 bg-gold/80'></div>
        </div>
        <aside class='lg:col-span-5'>
          <p
            class='text-[15px] sm:text-base text-slate-300 leading-[1.75] max-w-md'>
            Structured internship placements for clinical officers, nurses, and
            selected allied health cadres &mdash; forming part of SPMH&rsquo;s
            documented pathway to Level&nbsp;5 teaching hospital accreditation.
          </p>
          <div
            class='mt-8 flex flex-wrap items-center gap-x-8 gap-y-3 pt-6 border-t border-white/10'>
            <div class='flex items-baseline gap-2'>
              <span class='font-display text-2xl text-white'>12</span>
              <span
                class='text-[10px] uppercase tracking-[0.18em] text-slate-400'
                >Months</span
              >
            </div>
            <div class='flex items-baseline gap-2'>
              <span class='font-display text-2xl text-white'>6</span>
              <span
                class='text-[10px] uppercase tracking-[0.18em] text-slate-400'
                >Core competencies</span
              >
            </div>
            <div class='flex items-baseline gap-2'>
              <span class='font-display text-2xl text-white'>2030</span>
              <span
                class='text-[10px] uppercase tracking-[0.18em] text-slate-400'
                >Accreditation target</span
              >
            </div>
          </div>
          <div class='mt-10'>
            <a
              href='/apply/form'
              class='group inline-flex items-center gap-3 pl-6 pr-2 py-2 rounded-full
                       bg-white text-[#0A1730] font-semibold text-sm hover:bg-blue-50 transition-colors shadow-lg shadow-black/30'>
              <span>Apply now</span>
              <span
                class='inline-flex items-center justify-center w-9 h-9 rounded-full bg-[#0A1730] text-white
                           group-hover:translate-x-0.5 transition-transform'>
                <i class='fas fa-arrow-right text-xs' aria-hidden='true'></i>
              </span>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- CADRES -->
  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50'>
    <div class='max-w-7xl mx-auto'>
      <div class='max-w-3xl mb-14'>
        <span class='eyebrow'>Eligible Cadres</span>
        <h2
          class='mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-secondary text-balance'>
          Who we accept.
        </h2>
        <p class='mt-5 text-base sm:text-lg text-slate-600 leading-relaxed'>
          Internship placements are currently available across four cadres.
          Medical officer internships will open as our Level&nbsp;5
          accredited-internship capacity is established between 2028 and 2030.
        </p>
      </div>

      <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
        {
          cadres.map((c) => (
            <article class='flex gap-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-lg transition-shadow'>
              <div class='w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0'>
                <i class={`fas fa-${c.icon} text-lg`} aria-hidden='true' />
              </div>
              <div class='min-w-0 flex-1'>
                <div class='flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2'>
                  <h3 class='text-lg font-bold text-secondary'>{c.title}</h3>
                  <span class='text-[10px] font-semibold uppercase tracking-wider text-slate-400'>
                    {c.duration}
                  </span>
                </div>
                <p class='text-sm text-slate-600 leading-relaxed'>{c.note}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- COMPETENCIES -->
  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-white'>
    <div class='max-w-7xl mx-auto'>
      <div class='max-w-3xl mb-14'>
        <span class='eyebrow'>Competency Framework</span>
        <h2
          class='mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-secondary text-balance'>
          What you&rsquo;ll be assessed on.
        </h2>
        <p class='mt-5 text-base sm:text-lg text-slate-600 leading-relaxed'>
          The internship follows a documented competency framework. Each domain
          is formally assessed at quarterly review points.
        </p>
      </div>

      <ul class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5'>
        {
          competencies.map((c, i) => (
            <li class='rounded-2xl border border-slate-200 bg-white p-6 hover:border-primary/30 transition-colors'>
              <span class='font-mono text-xs text-slate-400'>0{i + 1}</span>
              <h3 class='mt-3 text-base font-bold text-secondary'>{c.title}</h3>
              <p class='mt-2 text-sm text-slate-600 leading-relaxed'>
                {c.detail}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- PATHWAY -->
  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-900 text-white'>
    <div class='max-w-7xl mx-auto'>
      <div class='max-w-3xl mb-14'>
        <span class='eyebrow-light'>Path to Accreditation</span>
        <h2
          class='mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-white text-balance'>
          Where the programme is going.
        </h2>
        <p class='mt-5 text-base sm:text-lg text-slate-300 leading-relaxed'>
          The internship programme grows in step with the hospital&rsquo;s
          Level&nbsp;5 pathway. Here is the phased timeline.
        </p>
      </div>
      <ol class='space-y-5'>
        {
          pathway.map((p) => (
            <li class='grid grid-cols-1 sm:grid-cols-12 gap-3 sm:gap-6 py-5 border-b border-white/10 last:border-0'>
              <span class='sm:col-span-3 font-mono text-sm text-primary-light'>
                {p.phase}
              </span>
              <span class='sm:col-span-2 text-sm text-slate-400'>
                {p.period}
              </span>
              <span class='sm:col-span-7 text-sm text-slate-200 leading-relaxed'>
                {p.status}
              </span>
            </li>
          ))
        }
      </ol>
      <div class='mt-12'>
        <a
          href='/level-5/roadmap'
          class='inline-flex items-center gap-2 text-sm font-semibold text-primary-light hover:gap-3 transition-all'>
          See the full Level 5 roadmap <i
            class='fas fa-arrow-right text-xs'
            aria-hidden='true'></i>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section
    class='py-20 px-4 sm:px-6 lg:px-8 bg-white border-t border-slate-100'>
    <div class='max-w-3xl mx-auto text-center'>
      <div class='mx-auto h-px w-16 bg-gold/70 mb-10'></div>
      <h2 class='text-3xl sm:text-4xl font-bold text-secondary text-balance'>
        Ready to intern at SPMH?
      </h2>
      <p class='mt-5 text-base text-slate-600 leading-relaxed'>
        Submit your application online. HR verification takes 3&ndash;5 working
        days; preceptor matching is confirmed 1&ndash;2 weeks before your start.
      </p>
      <div
        class='mt-10 flex flex-col sm:flex-row justify-center gap-3 sm:gap-4'>
        <a href='/apply/form' class='btn-primary px-6 py-3.5'>
          Apply for internship <i
            class='fas fa-arrow-right text-xs'
            aria-hidden='true'></i>
        </a>
        <a href='mailto:academics@spmh.co.ke' class='btn-secondary px-6 py-3.5'
          >Email HR</a
        >
      </div>
    </div>
  </section>
</LandingLayout>
