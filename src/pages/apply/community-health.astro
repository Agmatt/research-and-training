---
import LandingLayout from '../../layout/LandingLayout.astro';
import BaseHead from '../../components/seo/BaseHead.astro';
import { buildWebPage } from '../../components/seo/schema/webpage';
import { buildBreadcrumbs } from '../../components/seo/schema/breadcrumbs';
import { SITE } from '../../data/site';

const title = 'Community Health Training — CHP Field Programme | SPMH';
const description =
  "Field-based community health training with CHP-led systems across Homa Bay County. Structured 4–12 week placements at St. Paul's Mission Hospital.";
const path = '/apply/community-health';
const canonical = `${SITE.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPage({ title, description, path }),
    buildBreadcrumbs([
      { name: 'Home', item: `${SITE.mainSite.url}/` },
      { name: 'Training & Research', item: `${SITE.url}/` },
      { name: 'Apply', item: `${SITE.url}/apply` },
      { name: 'Community Health', item: `${SITE.url}/apply/community-health` },
    ]),
  ],
};

const focusAreas = [
  {
    icon: 'baby',
    title: 'Maternal & Child Health',
    detail:
      'Household-level maternal tracking, immunization follow-up, nutrition screening.',
  },
  {
    icon: 'notes-medical',
    title: 'Chronic Disease',
    detail:
      'Hypertension, diabetes, and HIV/TB follow-up, defaulter tracing, adherence support.',
  },
  {
    icon: 'hand-holding-heart',
    title: 'Preventive Health',
    detail:
      'Household education, sanitation, WASH promotion, and disease prevention.',
  },
  {
    icon: 'syringe',
    title: 'Outbreak Response',
    detail:
      'Community surveillance, early warning, and support to vaccination campaigns.',
  },
  {
    icon: 'brain',
    title: 'Mental Health',
    detail:
      'Community awareness, stigma reduction, and integration into primary care.',
  },
  {
    icon: 'school',
    title: 'Adolescent Health',
    detail:
      'School-linked programmes, reproductive health, and life-skills education.',
  },
];

const fieldStats = [
  { value: '~250K', label: 'Catchment served' },
  { value: '3', label: 'County sub-regions' },
  { value: '4', label: 'Key Result Areas' },
];
---

<LandingLayout currentPage='Apply'>
  <BaseHead
    slot='head'
    title={title}
    description={description}
    canonical={canonical}
    jsonLd={schema}
  />

  <section class='relative overflow-hidden bg-[#0A1730] text-white'>
    <div
      class='absolute inset-0 bg-gradient-to-br from-[#0A1730] via-[#0B1E3A] to-[#0E2549]'>
    </div>
    <div
      class='relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-20 pb-16 sm:pt-28 sm:pb-24'>
      <nav aria-label='Breadcrumb' class='mb-12'>
        <ol
          class='flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.24em] font-medium text-slate-500'>
          <li><a href='/' class='hover:text-white'>Home</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li><a href='/apply' class='hover:text-white'>Apply</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li class='text-gold'>Community Health</li>
        </ol>
      </nav>
      <div
        class='grid grid-cols-1 lg:grid-cols-12 gap-y-10 lg:gap-x-10 items-end'>
        <div class='lg:col-span-7'>
          <div class='flex items-center gap-4 mb-6'>
            <span class='h-px w-12 bg-gold/70'></span>
            <span
              class='text-[10px] sm:text-xs font-semibold uppercase tracking-[0.24em] text-gold'
              >Field-Based Training</span
            >
          </div>
          <h1
            class='font-display font-light text-white text-[2.5rem] leading-[1.02] sm:text-5xl lg:text-7xl xl:text-[5rem] tracking-[-0.03em] text-balance'>
            Public health,<br />
            in the <em class='not-italic font-normal text-primary-light'
              >field</em
            >.
          </h1>
          <div class='mt-8 h-px w-16 bg-gold/80'></div>
        </div>
        <aside class='lg:col-span-5'>
          <p
            class='text-[15px] sm:text-base text-slate-300 leading-[1.75] max-w-md'>
            Community-level training with CHP-led systems across Homa Bay
            County. Work alongside Community Health Promoters in households,
            schools, and outreach sites &mdash; where public health actually
            happens.
          </p>
          <div
            class='mt-8 flex flex-wrap items-center gap-x-8 gap-y-3 pt-6 border-t border-white/10'>
            {
              fieldStats.map((s) => (
                <div class='flex items-baseline gap-2'>
                  <span class='font-display text-2xl text-white'>
                    {s.value}
                  </span>
                  <span class='text-[10px] uppercase tracking-[0.18em] text-slate-400'>
                    {s.label}
                  </span>
                </div>
              ))
            }
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50'>
    <div class='max-w-7xl mx-auto'>
      <div class='max-w-3xl mb-14'>
        <span class='eyebrow'>Focus Areas</span>
        <h2
          class='mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-secondary text-balance'>
          Six domains of practice.
        </h2>
        <p class='mt-5 text-base sm:text-lg text-slate-600 leading-relaxed'>
          Community health placements rotate across six focus areas. Every
          student works under a designated CHP mentor and hospital-based
          community health officer.
        </p>
      </div>

      <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5'>
        {
          focusAreas.map((a) => (
            <article class='rounded-2xl border border-slate-200 bg-white p-6 hover:border-primary/30 transition-colors'>
              <div class='w-11 h-11 rounded-lg bg-primary/10 text-primary flex items-center justify-center mb-4'>
                <i class={`fas fa-${a.icon} text-base`} aria-hidden='true' />
              </div>
              <h3 class='text-base font-bold text-secondary'>{a.title}</h3>
              <p class='mt-2 text-sm text-slate-600 leading-relaxed'>
                {a.detail}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-white'>
    <div
      class='max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-y-12 lg:gap-x-16'>
      <div class='lg:col-span-5'>
        <span class='eyebrow'>Placement Logistics</span>
        <h2
          class='mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-secondary text-balance'>
          Practical details.
        </h2>
        <p class='mt-5 text-base text-slate-600 leading-relaxed'>
          Community health placements are coordinated through our Community
          Health Unit, in partnership with Homa Bay County community health
          structures.
        </p>
        <div class='mt-10 h-px w-16 bg-gold/70'></div>
      </div>
      <div class='lg:col-span-7'>
        <ul class='divide-y divide-slate-100 border-y border-slate-100'>
          {
            [
              {
                label: 'Duration',
                value: '4–12 weeks; typically aligned with academic terms.',
              },
              {
                label: 'Supervision',
                value: 'CHP mentor + hospital community health officer.',
              },
              {
                label: 'Location',
                value:
                  'Community Units across Homa Bay Town and surrounding sub-counties.',
              },
              {
                label: 'Fieldwork',
                value:
                  'Household visitation, outreach, screening, and health education.',
              },
              {
                label: 'Reporting',
                value:
                  'Structured weekly logs and a final project or presentation.',
              },
              {
                label: 'Transport',
                value: 'Support provided for scheduled outreach activities.',
              },
            ].map((r) => (
              <li class='py-5 grid grid-cols-1 sm:grid-cols-12 gap-2 sm:gap-4 items-start'>
                <p class='sm:col-span-4 text-sm font-semibold text-secondary'>
                  {r.label}
                </p>
                <p class='sm:col-span-8 text-sm text-slate-600 leading-relaxed'>
                  {r.value}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section
    class='py-20 px-4 sm:px-6 lg:px-8 bg-white border-t border-slate-100'>
    <div class='max-w-3xl mx-auto text-center'>
      <div class='mx-auto h-px w-16 bg-gold/70 mb-10'></div>
      <h2 class='text-3xl sm:text-4xl font-bold text-secondary text-balance'>
        Start your field placement.
      </h2>
      <p class='mt-5 text-base text-slate-600 leading-relaxed'>
        Submit your application and select Community Health as your rotation.
      </p>
      <div
        class='mt-10 flex flex-col sm:flex-row justify-center gap-3 sm:gap-4'>
        <a href='/apply/form' class='btn-primary px-6 py-3.5'>
          Apply now <i class='fas fa-arrow-right text-xs' aria-hidden='true'
          ></i>
        </a>
        <a href='/apply/clinical' class='btn-secondary px-6 py-3.5'
          >Other rotations</a
        >
      </div>
    </div>
  </section>
</LandingLayout>
