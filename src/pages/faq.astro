---
import LandingLayout from '../layout/LandingLayout.astro';
import BaseHead from '../components/seo/BaseHead.astro';
import { buildWebPage } from '../components/seo/schema/webpage';
import { buildBreadcrumbs } from '../components/seo/schema/breadcrumbs';
import { landingFaq } from '../components/seo/schema/faq';
import { SITE } from '../data/site';

const title = 'Frequently Asked Questions — SPMH Training & Research';
const description =
  "Common questions about clinical attachment, internship, research collaboration, and partnerships at St. Paul's Mission Hospital.";
const path = '/faq';
const canonical = `${SITE.url}${path}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPage({ title, description, path }),
    buildBreadcrumbs([
      { name: 'Home', item: `${SITE.mainSite.url}/` },
      { name: 'Training & Research', item: `${SITE.url}/` },
      { name: 'FAQ', item: `${SITE.url}/faq` },
    ]),
  ],
};

const faqs = Array.isArray(landingFaq) ? landingFaq : [];

const groups = [
  { title: 'General', items: faqs.slice(0, 2) },
  { title: 'Applications', items: faqs.slice(2) },
];
---

<LandingLayout currentPage='FAQ'>
  <BaseHead
    slot='head'
    title={title}
    description={description}
    canonical={canonical}
    jsonLd={schema}
  />

  <section class='relative bg-[#0A1730] text-white'>
    <div
      class='absolute inset-0 bg-gradient-to-br from-[#0A1730] via-[#0B1E3A] to-[#0E2549]'>
    </div>
    <div
      class='relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-20 pb-16 sm:pt-28 sm:pb-20'>
      <nav aria-label='Breadcrumb' class='mb-12'>
        <ol
          class='flex flex-wrap items-center gap-2 text-[10px] uppercase tracking-[0.24em] font-medium text-slate-500'>
          <li><a href='/' class='hover:text-white'>Home</a></li>
          <li aria-hidden='true' class='text-slate-700'>/</li>
          <li class='text-gold'>FAQ</li>
        </ol>
      </nav>
      <div
        class='grid grid-cols-1 lg:grid-cols-12 gap-y-10 lg:gap-x-10 items-end'>
        <div class='lg:col-span-7'>
          <div class='flex items-center gap-4 mb-6'>
            <span class='h-px w-12 bg-gold/70'></span>
            <span
              class='text-[10px] sm:text-xs font-semibold uppercase tracking-[0.24em] text-gold'
              >Frequently Asked</span
            >
          </div>
          <h1
            class='font-display font-light text-white text-[2.5rem] leading-[1.02] sm:text-5xl lg:text-7xl tracking-[-0.03em] text-balance'>
            Answers,<br />
            <em class='not-italic font-normal text-primary-light'>before</em> you
            ask.
          </h1>
          <div class='mt-8 h-px w-16 bg-gold/80'></div>
        </div>
        <aside class='lg:col-span-5'>
          <p
            class='text-[15px] sm:text-base text-slate-300 leading-[1.75] max-w-md'>
            The questions we get most often. If yours isn&rsquo;t here, email
            <a
              href='mailto:academics@spmh.co.ke'
              class='text-primary-light hover:underline'>academics@spmh.co.ke</a
            >.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class='py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-white'>
    <div class='max-w-3xl mx-auto'>
      {
        groups.map(
          (g, gi) =>
            g.items.length > 0 && (
              <div class={gi > 0 ? 'mt-12' : ''}>
                <h2 class='text-sm font-semibold uppercase tracking-[0.22em] text-slate-400 mb-5'>
                  {g.title}
                </h2>
                <div class='space-y-3'>
                  {g.items.map((item) => (
                    <details
                      class='group rounded-xl border border-slate-200 bg-slate-50
                                open:bg-white open:shadow-md transition-all'>
                      <summary
                        class='flex items-center justify-between gap-4 cursor-pointer
                                  px-6 py-4 font-semibold text-secondary list-none
                                  [&::-webkit-details-marker]:hidden'>
                        <span>{item.q}</span>
                        <i
                          class='fas fa-chevron-down text-xs text-slate-400 shrink-0
                              transition-transform group-open:rotate-180'
                          aria-hidden='true'
                        />
                      </summary>
                      <div class='px-6 pb-5 text-sm text-slate-600 leading-relaxed'>
                        {item.a}
                      </div>
                    </details>
                  ))}
                </div>
              </div>
            ),
        )
      }

      <div class='mt-14 rounded-2xl bg-slate-900 text-white p-8 text-center'>
        <h3 class='text-xl font-bold text-white'>Still have questions?</h3>
        <p class='mt-2 text-sm text-slate-300'>
          We respond to email within two working days.
        </p>
        <a
          href='mailto:academics@spmh.co.ke'
          class='mt-6 inline-flex btn-primary px-6 py-3'>
          Email us <i class='fas fa-arrow-right text-xs' aria-hidden='true'></i>
        </a>
      </div>
    </div>
  </section>
</LandingLayout>
