---
/**
 * AcademicsNavbar v2
 * - Fonts: Fraunces for the wordmark, Plus Jakarta Sans for all UI/nav.
 * - Paths: subdomain-root-relative (from src/data/nav.ts).
 * - Cross-domain links: absolute to www.spmh.co.ke.
 * - Alpine owns drawer + dropdown state; x-cloak prevents flash.
 */
import { SITE } from '../data/site';
import { navItems, megamenus, colsFor } from '../data/nav';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
};

const adminLinks = [
  { label: 'Dashboard',            href: '/admin/academics/dashboard',    icon: 'chart-line' },
  { label: 'Applicant Management', href: '/admin/academics/applicants',   icon: 'users' },
  { label: 'Supervisor Tools',     href: '/admin/academics/supervisors',  icon: 'user-tie' },
  { label: 'Partnership Tracking', href: '/admin/academics/partnerships', icon: 'handshake' },
  { label: 'Settings',             href: '/admin/academics/settings',     icon: 'cog' },
];

const socials = [
  { label: 'Facebook', href: SITE.socials.facebook, icon: 'fa-facebook',  color: 'hover:text-[#1877F2]' },
  { label: 'X',        href: SITE.socials.x,        icon: 'fa-x-twitter', color: 'hover:text-black' },
  { label: 'TikTok',   href: SITE.socials.tiktok,   icon: 'fa-tiktok',    color: 'hover:text-[#FE2C55]' },
  { label: 'LinkedIn', href: SITE.socials.linkedin, icon: 'fa-linkedin',  color: 'hover:text-[#0A66C2]' },
];
---

<style is:global>
  [x-cloak] { display: none !important; }
</style>

<header
  class="sticky top-0 z-50 bg-white"
  x-data="{
    mobileOpen: false,
    desktopDropdown: null,
    mobileDropdown: null,
  }"
  @keydown.escape.window="mobileOpen = false; desktopDropdown = null"
>
  <!-- ============================================================
       TOP BAR — identity + socials
       ============================================================ -->
  <div class="border-b border-slate-200 bg-white">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-16 md:h-20 flex items-center justify-between gap-2">

      <!-- Identity -->
      <a href={SITE.paths.home} class="flex items-center gap-2 md:gap-4 min-w-0" aria-label={`${SITE.name} — home`}>
        <img
          src="/logos/logo.png"
          alt=""
          width="56"
          height="56"
          class="h-10 sm:h-12 md:h-14 w-auto flex-shrink-0"
        />
        <span class="flex flex-col min-w-0">
          <span class="font-display text-[#125276] font-bold text-xs sm:text-sm md:text-base leading-tight truncate">
            St. Paul&rsquo;s Mission Hospital
          </span>
          <span class="text-[#860f0f] font-bold text-[8px] sm:text-[10px] md:text-sm uppercase tracking-wider truncate">
            Academics, Research &amp; Training
          </span>
          <span class="hidden sm:block text-[#1565c0] text-[10px] md:text-xs font-medium truncate">
            Level 5-Ready Teaching Hospital
          </span>
        </span>
      </a>

      <!-- Socials -->
      <div class="flex items-center gap-1 sm:gap-2 flex-shrink-0">
        {socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
            class={`p-1.5 text-slate-400 ${s.color} transition-colors rounded-md hover:bg-slate-50`}
          >
            <i class={`fab ${s.icon} text-base sm:text-lg`} aria-hidden="true" />
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- ============================================================
       MAIN NAV — primary blue, mouseleave on <nav> closes panels
       ============================================================ -->
  <nav
    class="bg-primary text-white relative"
    aria-label="Primary"
    @mouseleave="desktopDropdown = null"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between relative">

      <!-- Desktop nav items -->
      <div class="hidden lg:flex items-center gap-1">
        {navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <div
              @mouseenter={
                item.submenu
                  ? `desktopDropdown = '${item.submenu}'`
                  : `desktopDropdown = null`
              }
            >
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                aria-haspopup={item.submenu ? 'true' : undefined}
                class={`flex items-center gap-1.5 px-4 py-2 text-sm font-medium tracking-wide uppercase transition-colors ${
                  active
                    ? 'text-white bg-primary-dark'
                    : 'text-blue-100 hover:text-white hover:bg-primary-dark/70'
                }`}
              >
                {item.label}
                {item.submenu && (
                  <i
                    class="fas fa-chevron-down text-[10px] transition-transform"
                    :class={`desktopDropdown === '${item.submenu}' ? 'rotate-180' : ''`}
                    aria-hidden="true"
                  />
                )}
              </a>

              <!-- Megamenu -->
              {item.submenu && megamenus[item.submenu] && (
                <div
                  x-show={`desktopDropdown === '${item.submenu}'`}
                  x-cloak
                  x-transition:enter="transition ease-out duration-150"
                  x-transition:enter-start="opacity-0 translate-y-1"
                  x-transition:enter-end="opacity-100 translate-y-0"
                  x-transition:leave="transition ease-in duration-100"
                  x-transition:leave-start="opacity-100 translate-y-0"
                  x-transition:leave-end="opacity-0 translate-y-1"
                  class={`absolute top-full left-0 right-0 bg-white text-slate-900 rounded-b-2xl shadow-2xl border-t-4 border-primary-dark p-8 grid ${colsFor(
                    megamenus[item.submenu].sections.length,
                  )} gap-8 z-50`}
                >
                  {megamenus[item.submenu].sections.map((section) => (
                    <div class="space-y-3">
                      <div class="flex items-center gap-2 pb-2 border-b border-slate-200">
                        <span class="w-8 h-8 rounded flex items-center justify-center text-primary">
                          <i class={`fas fa-${section.icon} text-sm`} aria-hidden="true" />
                        </span>
                        <h3 class="text-slate-900 font-bold text-xs uppercase tracking-wider flex items-center gap-2">
                          {section.title}
                          {section.badge && (
                            <span class="text-[10px] px-2 py-0.5 bg-emerald-100 text-emerald-700 rounded-full font-semibold normal-case tracking-normal">
                              {section.badge}
                            </span>
                          )}
                        </h3>
                      </div>

                      <ul class="space-y-0.5">
                        {section.items.map((link) => (
                          <li>
                            {link.cta ? (
                              <a
                                href={link.href}
                                class="mt-1 inline-flex items-center gap-1 text-sm px-3 py-1.5 rounded bg-primary text-white hover:bg-primary-dark transition-colors font-semibold"
                              >
                                {link.label}
                              </a>
                            ) : link.download ? (
                              <a
                                href={link.href}
                                download
                                class="text-sm text-slate-600 hover:text-primary transition-colors flex items-center gap-1.5 py-1"
                              >
                                <i class="fas fa-download text-xs" aria-hidden="true" />
                                {link.label}
                              </a>
                            ) : (
                              <a
                                href={link.href}
                                class="text-sm text-slate-600 hover:text-slate-900 transition-colors block py-1"
                              >
                                {link.label}
                              </a>
                            )}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </div>

      <!-- Search + Admin -->
      <div class="hidden lg:flex items-center flex-1 justify-end gap-4 pl-8">
        <form class="relative" role="search" @mouseenter="desktopDropdown = null">
          <label for="site-search" class="sr-only">Search</label>
          <input
            id="site-search"
            type="search"
            placeholder="Search…"
            class="bg-white/10 border border-white/20 rounded-full pl-4 pr-10 py-2 text-sm text-white placeholder-blue-200 focus:outline-none focus:ring-2 focus:ring-white/50 focus:bg-white/15 w-48 transition-colors"
          />
          <button
            type="submit"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-blue-200 hover:text-white"
            aria-label="Search"
          >
            <i class="fas fa-search text-sm" aria-hidden="true" />
          </button>
        </form>

        <!-- Admin dropdown — anchored to its own button -->
        <div
          class="relative"
          @mouseenter="desktopDropdown = 'admin'"
          @mouseleave="desktopDropdown = null"
        >
          <button
            type="button"
            class="flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-blue-100 hover:text-white hover:bg-primary-dark/70 rounded transition-colors"
            aria-haspopup="menu"
          >
            <i class="fas fa-lock text-xs" aria-hidden="true" />
            Admin
            <i
              class="fas fa-chevron-down text-[10px] transition-transform"
              :class={`desktopDropdown === 'admin' ? 'rotate-180' : ''`}
              aria-hidden="true"
            />
          </button>

          <div
            x-show={`desktopDropdown === 'admin'`}
            x-cloak
            x-transition
            role="menu"
            class="absolute top-full right-0 mt-0 w-60 bg-white text-slate-900 rounded-xl shadow-xl border border-slate-200 py-2 z-50"
          >
            {adminLinks.map((link) => (
              <a
                href={link.href}
                role="menuitem"
                class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50"
              >
                <i class={`fas fa-${link.icon} text-xs text-primary w-4`} aria-hidden="true" />
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Mobile menu button -->
            <!-- Mobile menu button -->
      <button
        type="button"
        @click="mobileOpen = !mobileOpen"
        class="lg:hidden flex items-center justify-center w-10 h-10 text-white rounded transition-colors ml-auto
               hover:bg-primary-dark/60 active:bg-primary-dark"
        :aria-expanded="mobileOpen"
        aria-controls="mobile-drawer"
        aria-label="Toggle navigation"
      >
        <!-- Bars: shown when drawer is closed. Static, no Alpine — always renders. -->
        <i class="fas fa-bars text-lg" x-show="!mobileOpen" aria-hidden="true"></i>

        <!-- Cross: hidden by x-cloak until Alpine boots, then toggled by x-show. -->
        <i class="fas fa-times text-lg" x-show="mobileOpen" x-cloak aria-hidden="true"></i>
      </button>
    </div>
  </nav>

  <!-- ============================================================
       MOBILE DRAWER
       ============================================================ -->
  <div
    id="mobile-drawer"
    x-show="mobileOpen"
    x-cloak
    x-transition:enter="transition transform ease-out duration-300"
    x-transition:enter-start="translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition transform ease-in duration-200"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="translate-x-full"
    @click.away="mobileOpen = false"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation"
    class="fixed inset-y-0 right-0 z-50 w-full max-w-xs bg-gradient-to-b from-slate-900 to-slate-950 text-white border-l border-slate-800 shadow-2xl lg:hidden flex flex-col"
  >
    <div class="flex items-center justify-between px-4 h-16 border-b border-slate-800 bg-slate-900">
      <span class="text-xs font-bold uppercase tracking-widest text-slate-300">
        Training &amp; Research
      </span>
      <button
        type="button"
        @click="mobileOpen = false"
        class="w-9 h-9 flex items-center justify-center text-slate-300 hover:text-white hover:bg-slate-800 rounded transition-colors"
        aria-label="Close navigation"
      >
        <i class="fas fa-times" aria-hidden="true" />
      </button>
    </div>

    <div class="flex-1 px-4 py-4 overflow-y-auto divide-y divide-slate-800/60">
      {navItems.map((item) => (
        <div class="py-2">
          {item.submenu ? (
            <button
              type="button"
              @click={`mobileDropdown = mobileDropdown === '${item.submenu}' ? null : '${item.submenu}'`}
              class="w-full flex items-center justify-between px-3 py-2.5 text-sm font-medium text-slate-200 hover:text-white hover:bg-slate-800/80 rounded transition-colors"
              :aria-expanded={`mobileDropdown === '${item.submenu}'`}
            >
              <span>{item.label}</span>
              <i
                class="fas fa-chevron-down text-xs transition-transform text-slate-400"
                :class={`mobileDropdown === '${item.submenu}' ? 'rotate-180 text-white' : ''`}
                aria-hidden="true"
              />
            </button>
          ) : (
            <a
              href={item.href}
              @click="mobileOpen = false"
              class="block px-3 py-2.5 text-sm font-medium text-slate-200 hover:text-white hover:bg-slate-800/80 rounded transition-colors"
            >
              {item.label}
            </a>
          )}

          {item.submenu && megamenus[item.submenu] && (
            <div
              x-show={`mobileDropdown === '${item.submenu}'`}
              x-cloak
              x-transition
              class="bg-slate-950/80 rounded-md my-1 pl-2 border-l-2 border-primary space-y-2 py-2"
            >
              {megamenus[item.submenu].sections.map((section) => (
                <div class="pb-2 last:pb-0 px-2">
                  <p class="text-[11px] font-bold text-primary-light uppercase pt-2 pb-1 mb-1">
                    {section.title}
                  </p>
                  <ul class="space-y-0.5">
                    {section.items.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          @click="mobileOpen = false"
                          class="block px-2 py-1.5 text-xs text-slate-300 hover:text-white hover:bg-slate-800/50 rounded transition-colors"
                        >
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )}
        </div>
      ))}

      <div class="pt-3 mt-3">
        <a
          href="/admin/academics/dashboard"
          @click="mobileOpen = false"
          class="flex items-center px-3 py-2.5 text-sm font-medium text-slate-200 hover:text-white hover:bg-slate-800/80 rounded transition-colors"
        >
          <i class="fas fa-lock text-xs mr-2 text-primary-light" aria-hidden="true" />
          Admin Portal
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Alpine.js — deferred, self-contained. Swap for npm install + import in the layout when ready. -->
<script is:inline defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>