---
/**
 * AcademicsNavbar v2 — responsive
 * - lg (1024-1279): compact nav, narrow search, icon-only admin
 * - xl+ (1280+): full spacing
 * - < lg: hamburger drawer
 */
import { SITE } from '../data/site';
import { navItems, megamenus, colsFor } from '../data/nav';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
};

const socials = [
  { label: 'Facebook', href: SITE.socials.facebook, icon: 'fa-facebook',  color: 'hover:text-[#1877F2]' },
  { label: 'X',        href: SITE.socials.x,        icon: 'fa-x-twitter', color: 'hover:text-black' },
  { label: 'TikTok',   href: SITE.socials.tiktok,   icon: 'fa-tiktok',    color: 'hover:text-[#FE2C55]' },
  { label: 'LinkedIn', href: SITE.socials.linkedin, icon: 'fa-linkedin',  color: 'hover:text-[#0A66C2]' },
];

const adminLinks = [
  { label: 'Dashboard',            href: '/admin/academics/dashboard',    icon: 'chart-line' },
  { label: 'Applicant Management', href: '/admin/academics/applicants',   icon: 'users' },
  { label: 'Supervisor Tools',     href: '/admin/academics/supervisors',  icon: 'user-tie' },
  { label: 'Partnership Tracking', href: '/admin/academics/partnerships', icon: 'handshake' },
  { label: 'Settings',             href: '/admin/academics/settings',     icon: 'cog' },
];
---

<header
  class="sticky top-0 z-50 bg-white"
  x-data="{
    mobileOpen: false,
    desktopDropdown: null,
    mobileDropdown: null,
  }"
  @keydown.escape.window="mobileOpen = false; desktopDropdown = null"
>
  <!-- ============================================================
       TOP BAR — identity + socials
       ============================================================ -->
  <div class="border-b border-slate-200 bg-white">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-16 md:h-20 flex items-center justify-between gap-3">

      <!-- Identity -->
      <a href={SITE.paths.home} class="flex items-center gap-2 md:gap-4 min-w-0" aria-label={`${SITE.name} — home`}>
        <img
          src="/logos/logo.png"
          alt=""
          width="56"
          height="56"
          class="h-10 sm:h-12 md:h-14 w-auto flex-shrink-0"
        />
        <span class="flex flex-col min-w-0">
          <span class="font-display text-[#125276] font-bold text-xs sm:text-sm md:text-base leading-tight truncate">
            St. Paul&rsquo;s Mission Hospital
          </span>
          <span class="text-[#860f0f] font-bold text-[8px] sm:text-[10px] md:text-sm uppercase tracking-wider truncate">
            Academics, Research &amp; Training
          </span>
          <span class="hidden md:block text-[#1565c0] text-[10px] md:text-xs font-medium truncate">
            Level 5-Ready Teaching Hospital
          </span>
        </span>
      </a>

      <!-- Socials — hidden on very small screens to save room -->
      <div class="hidden sm:flex items-center gap-1 md:gap-2 flex-shrink-0">
        {socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
            class={`p-1.5 text-slate-400 ${s.color} transition-colors rounded-md hover:bg-slate-50`}
          >
            <i class={`fab ${s.icon} text-base sm:text-lg`} aria-hidden="true" />
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- ============================================================
       MAIN NAV
       ============================================================ -->
  <nav
    class="bg-primary text-white relative"
    aria-label="Primary"
    @mouseleave="desktopDropdown = null"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-6 xl:px-8 h-14 flex items-center justify-between gap-4 relative">

      <!-- ============================================================
           DESKTOP LEFT — primary nav items (lg and up)
           ============================================================ -->
      <div class="hidden lg:flex items-center gap-0.5 xl:gap-1 flex-shrink-0">
        {navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <div
              @mouseenter={
                item.submenu
                  ? `desktopDropdown = '${item.submenu}'`
                  : `desktopDropdown = null`
              }
            >
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                aria-haspopup={item.submenu ? 'true' : undefined}
                class={`flex items-center gap-1 whitespace-nowrap
                        px-2.5 xl:px-4 py-2
                        text-xs xl:text-sm font-medium tracking-wide uppercase
                        transition-colors ${
                  active
                    ? 'text-white bg-primary-dark'
                    : 'text-blue-100 hover:text-white hover:bg-primary-dark/70'
                }`}
              >
                {item.label}
                {item.submenu && (
                  <i
                    class="fas fa-chevron-down text-[9px] xl:text-[10px] transition-transform"
                    :class={`desktopDropdown === '${item.submenu}' ? 'rotate-180' : ''`}
                    aria-hidden="true"
                  />
                )}
              </a>

              <!-- Megamenu -->
              {item.submenu && megamenus[item.submenu] && (
                <div
                  x-show={`desktopDropdown === '${item.submenu}'`}
                  x-cloak
                  x-transition:enter="transition ease-out duration-150"
                  x-transition:enter-start="opacity-0 translate-y-1"
                  x-transition:enter-end="opacity-100 translate-y-0"
                  x-transition:leave="transition ease-in duration-100"
                  x-transition:leave-start="opacity-100 translate-y-0"
                  x-transition:leave-end="opacity-0 translate-y-1"
                  class={`absolute top-full left-0 right-0 bg-white text-slate-900
                          rounded-b-2xl shadow-2xl border-t-4 border-primary-dark
                          p-6 xl:p-8 grid ${colsFor(
                            megamenus[item.submenu].sections.length,
                          )} gap-6 xl:gap-8 z-50`}
                >
                  {megamenus[item.submenu].sections.map((section) => (
                    <div class="space-y-3">
                      <div class="flex items-center gap-2 pb-2 border-b border-slate-200">
                        <span class="w-8 h-8 rounded flex items-center justify-center text-primary">
                          <i class={`fas fa-${section.icon} text-sm`} aria-hidden="true" />
                        </span>
                        <h3 class="text-slate-900 font-bold text-xs uppercase tracking-wider flex items-center gap-2">
                          {section.title}
                          {section.badge && (
                            <span class="text-[10px] px-2 py-0.5 bg-emerald-100 text-emerald-700 rounded-full font-semibold normal-case tracking-normal">
                              {section.badge}
                            </span>
                          )}
                        </h3>
                      </div>

                      <ul class="space-y-0.5">
                        {section.items.map((link) => (
                          <li>
                            {link.cta ? (
                              <a
                                href={link.href}
                                class="mt-1 inline-flex items-center gap-1 text-sm px-3 py-1.5 rounded bg-primary text-white hover:bg-primary-dark transition-colors font-semibold"
                              >
                                {link.label}
                              </a>
                            ) : link.download ? (
                              <a
                                href={link.href}
                                download
                                class="text-sm text-slate-600 hover:text-primary transition-colors flex items-center gap-1.5 py-1"
                              >
                                <i class="fas fa-download text-xs" aria-hidden="true" />
                                {link.label}
                              </a>
                            ) : (
                              <a
                                href={link.href}
                                class="text-sm text-slate-600 hover:text-slate-900 transition-colors block py-1"
                              >
                                {link.label}
                              </a>
                            )}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </div>

      <!-- ============================================================
           DESKTOP RIGHT — Search + Admin (all inside hidden lg:flex)
           ============================================================ -->
      <div class="hidden lg:flex items-center gap-2 xl:gap-4 ml-auto flex-shrink-0">

        <!-- Search -->
        <div class="relative" x-data="searchBar" @mouseenter="desktopDropdown = null">
          <form @submit.prevent="goToSelected()" class="relative" role="search">
            <label for="site-search" class="sr-only">Search</label>
            <input
              id="site-search"
              type="search"
              placeholder="Search…"
              x-ref="searchInput"
              x-model="query"
              @focus="open()"
              @input.debounce.120ms="performSearch()"
              @keydown.down.prevent="moveDown()"
              @keydown.up.prevent="moveUp()"
              @keydown.enter.prevent="goToSelected()"
              :aria-expanded="isOpen"
              autocomplete="off"
              spellcheck="false"
              class="bg-white/10 border border-white/20 rounded-full
                     pl-3 xl:pl-4 pr-9 py-1.5 xl:py-2
                     text-xs xl:text-sm text-white
                     placeholder-blue-200 focus:outline-none focus:ring-2 focus:ring-white/50 focus:bg-white/15
                     w-36 xl:w-56 transition-all"
            />
            <button
              type="submit"
              class="absolute right-2.5 xl:right-3 top-1/2 -translate-y-1/2 text-blue-200 hover:text-white"
              aria-label="Search"
            >
              <i class="fas fa-search text-xs xl:text-sm" aria-hidden="true" />
            </button>
          </form>

          <!-- Results dropdown -->
          <div
            x-show="isOpen"
            x-cloak
            x-transition:enter="transition ease-out duration-120"
            x-transition:enter-start="opacity-0 translate-y-1"
            x-transition:enter-end="opacity-100 translate-y-0"
            @click.away="close()"
            role="listbox"
            class="absolute top-full right-0 mt-2 w-[min(28rem,calc(100vw-2rem))]
                   bg-white text-slate-900 rounded-xl shadow-2xl
                   border border-slate-200 overflow-hidden z-[60]"
          >
            <template x-if="query.length === 0">
              <div class="px-5 py-6 text-center">
                <p class="text-xs uppercase tracking-wider text-slate-400 font-semibold mb-3">Popular searches</p>
                <div class="flex flex-wrap justify-center gap-2">
                  <button type="button" @click="setQuery('clinical attachment')" class="px-3 py-1 rounded-full bg-slate-100 text-xs text-slate-700 hover:bg-slate-200 transition-colors">Clinical attachment</button>
                  <button type="button" @click="setQuery('internship')" class="px-3 py-1 rounded-full bg-slate-100 text-xs text-slate-700 hover:bg-slate-200 transition-colors">Internship</button>
                  <button type="button" @click="setQuery('ethics')" class="px-3 py-1 rounded-full bg-slate-100 text-xs text-slate-700 hover:bg-slate-200 transition-colors">Ethics</button>
                  <button type="button" @click="setQuery('level 5')" class="px-3 py-1 rounded-full bg-slate-100 text-xs text-slate-700 hover:bg-slate-200 transition-colors">Level 5</button>
                </div>
              </div>
            </template>

            <template x-if="query.length > 0 && query.length < 2">
              <div class="px-5 py-6 text-center">
                <p class="text-xs text-slate-500">Type at least 2 characters to search.</p>
              </div>
            </template>

            <template x-if="query.length >= 2 && results.length === 0">
              <div class="px-5 py-8 text-center">
                <i class="fas fa-magnifying-glass text-2xl text-slate-300 mb-3" aria-hidden="true" />
                <p class="text-sm text-slate-600">No results for &ldquo;<span class="font-semibold" x-text="query"></span>&rdquo;</p>
                <a href="/faq" class="mt-3 inline-block text-xs text-primary hover:underline">Try the FAQ</a>
              </div>
            </template>

            <template x-if="query.length >= 2 && results.length > 0">
              <ul class="max-h-[24rem] overflow-y-auto py-1">
                <template x-for="(result, i) in results" :key="result.href + i">
                  <li role="option" :aria-selected="selectedIndex === i">
                    <a :href="result.href" @mouseenter="selectedIndex = i" @click="close()"
                       :class="selectedIndex === i ? 'bg-slate-50' : ''"
                       class="flex items-start gap-3 px-4 py-2.5 transition-colors">
                      <span class="w-8 h-8 rounded-md bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
                        <i class="fas text-xs" :class="`fa-${result.icon || 'file'}`" aria-hidden="true"></i>
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="block text-sm font-semibold text-secondary truncate" x-text="result.title"></span>
                        <span class="block text-xs text-slate-500 mt-0.5 truncate" x-text="result.section"></span>
                      </span>
                    </a>
                  </li>
                </template>
              </ul>
            </template>

            <template x-if="query.length >= 2 && results.length > 0">
              <div class="px-4 py-2 border-t border-slate-100 bg-slate-50 text-[10px] text-slate-400 flex items-center gap-3">
                <span><kbd class="px-1.5 py-0.5 bg-white rounded border border-slate-200 font-mono">↑↓</kbd> navigate</span>
                <span><kbd class="px-1.5 py-0.5 bg-white rounded border border-slate-200 font-mono">↵</kbd> open</span>
                <span><kbd class="px-1.5 py-0.5 bg-white rounded border border-slate-200 font-mono">Esc</kbd> close</span>
              </div>
            </template>
          </div>
        </div>

        <!-- Admin dropdown -->
        <div
          class="relative"
          @mouseenter="desktopDropdown = 'admin'"
          @mouseleave="desktopDropdown = null"
        >
          <button
            type="button"
            aria-label="Admin menu"
            class="flex items-center gap-1 xl:gap-1.5
                   px-2.5 xl:px-4 py-2
                   text-xs xl:text-sm font-medium
                   text-blue-100 hover:text-white hover:bg-primary-dark/70
                   rounded transition-colors"
            aria-haspopup="menu"
          >
            <i class="fas fa-lock text-[10px] xl:text-xs" aria-hidden="true" />
            <!-- Label hidden on lg, shown on xl -->
            <span class="hidden xl:inline">Admin</span>
            <i
              class="fas fa-chevron-down text-[9px] xl:text-[10px] transition-transform"
              :class={`desktopDropdown === 'admin' ? 'rotate-180' : ''`}
              aria-hidden="true"
            />
          </button>

          <div
            x-show={`desktopDropdown === 'admin'`}
            x-cloak
            x-transition
            role="menu"
            class="absolute top-full right-0 mt-1 w-60 bg-white text-slate-900 rounded-xl shadow-xl border border-slate-200 py-2 z-50"
          >
            {adminLinks.map((link) => (
              <a
                href={link.href}
                role="menuitem"
                class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50"
              >
                <i class={`fas fa-${link.icon} text-xs text-primary w-4`} aria-hidden="true" />
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- ============================================================
           MOBILE MENU BUTTON (< lg)
           ============================================================ -->
      <button
        type="button"
        @click="mobileOpen = !mobileOpen"
        class="lg:hidden flex items-center justify-center w-10 h-10 text-white rounded transition-colors ml-auto
               hover:bg-primary-dark/60 active:bg-primary-dark"
        :aria-expanded="mobileOpen"
        aria-controls="mobile-drawer"
        aria-label="Toggle navigation"
      >
        <i class="fas fa-bars text-lg" x-show="!mobileOpen" aria-hidden="true"></i>
        <i class="fas fa-times text-lg" x-show="mobileOpen" x-cloak aria-hidden="true"></i>
      </button>
    </div>
  </nav>

  <!-- ============================================================
       MOBILE DRAWER
       ============================================================ -->
  <div
    id="mobile-drawer"
    x-show="mobileOpen"
    x-cloak
    x-transition:enter="transition transform ease-out duration-300"
    x-transition:enter-start="translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition transform ease-in duration-200"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="translate-x-full"
    @click.away="mobileOpen = false"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation"
    class="fixed inset-y-0 right-0 z-50 w-full max-w-xs bg-gradient-to-b from-slate-900 to-slate-950 text-white border-l border-slate-800 shadow-2xl lg:hidden flex flex-col"
  >
    <div class="flex items-center justify-between px-4 h-16 border-b border-slate-800 bg-slate-900">
      <span class="text-xs font-bold uppercase tracking-widest text-slate-300">
        Training &amp; Research
      </span>
      <button
        type="button"
        @click="mobileOpen = false"
        class="w-9 h-9 flex items-center justify-center text-slate-300 hover:text-white hover:bg-slate-800 rounded transition-colors"
        aria-label="Close navigation"
      >
        <i class="fas fa-times" aria-hidden="true" />
      </button>
    </div>

    <!-- Search in mobile drawer -->
    <div class="px-4 pt-4 pb-2 border-b border-slate-800/60">
      <div class="relative" x-data="searchBar">
        <form @submit.prevent="goToSelected()" class="relative" role="search">
          <label for="mobile-search" class="sr-only">Search</label>
          <input
            id="mobile-search"
            type="search"
            placeholder="Search site…"
            x-ref="searchInput"
            x-model="query"
            @focus="open()"
            @input.debounce.120ms="performSearch()"
            @keydown.down.prevent="moveDown()"
            @keydown.up.prevent="moveUp()"
            @keydown.enter.prevent="goToSelected()"
            autocomplete="off"
            spellcheck="false"
            class="w-full bg-white/10 border border-white/20 rounded-full
                   pl-4 pr-10 py-2.5 text-sm text-white
                   placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-white/50"
          />
          <button
            type="submit"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white"
            aria-label="Search"
          >
            <i class="fas fa-search text-sm" aria-hidden="true" />
          </button>
        </form>

        <!-- Compact results (inline, not floating) -->
        <div x-show="isOpen" x-cloak class="mt-2">
          <template x-if="query.length >= 2 && results.length === 0">
            <p class="text-xs text-slate-400 px-3 py-2">No results — try the <a href="/faq" class="text-primary-light underline">FAQ</a>.</p>
          </template>
          <template x-if="query.length >= 2 && results.length > 0">
            <ul class="bg-slate-950/80 rounded-md border border-slate-800 overflow-hidden">
              <template x-for="(result, i) in results.slice(0, 6)" :key="result.href + i">
                <li>
                  <a :href="result.href" @click="mobileOpen = false"
                     class="flex items-center gap-2.5 px-3 py-2.5 text-xs text-slate-200 hover:bg-slate-800/80 border-b border-slate-800/60 last:border-0">
                    <i class="fas text-[10px] text-primary-light" :class="`fa-${result.icon || 'file'}`" aria-hidden="true"></i>
                    <span class="min-w-0 flex-1">
                      <span class="block font-semibold truncate" x-text="result.title"></span>
                      <span class="block text-[10px] text-slate-500 truncate" x-text="result.section"></span>
                    </span>
                  </a>
                </li>
              </template>
            </ul>
          </template>
        </div>
      </div>
    </div>

    <div class="flex-1 px-4 py-4 overflow-y-auto divide-y divide-slate-800/60">
      {navItems.map((item) => (
        <div class="py-2">
          {item.submenu ? (
            <button
              type="button"
              @click={`mobileDropdown = mobileDropdown === '${item.submenu}' ? null : '${item.submenu}'`}
              class="w-full flex items-center justify-between px-3 py-2.5 text-sm font-medium text-slate-200 hover:text-white hover:bg-slate-800/80 rounded transition-colors"
              :aria-expanded={`mobileDropdown === '${item.submenu}'`}
            >
              <span>{item.label}</span>
              <i
                class="fas fa-chevron-down text-xs transition-transform text-slate-400"
                :class={`mobileDropdown === '${item.submenu}' ? 'rotate-180 text-white' : ''`}
                aria-hidden="true"
              />
            </button>
          ) : (
            <a
              href={item.href}
              @click="mobileOpen = false"
              class="block px-3 py-2.5 text-sm font-medium text-slate-200 hover:text-white hover:bg-slate-800/80 rounded transition-colors"
            >
              {item.label}
            </a>
          )}

          {item.submenu && megamenus[item.submenu] && (
            <div
              x-show={`mobileDropdown === '${item.submenu}'`}
              x-cloak
              x-transition
              class="bg-slate-950/80 rounded-md my-1 pl-2 border-l-2 border-primary space-y-2 py-2"
            >
              {megamenus[item.submenu].sections.map((section) => (
                <div class="pb-2 last:pb-0 px-2">
                  <p class="text-[11px] font-bold text-primary-light uppercase pt-2 pb-1 mb-1">
                    {section.title}
                  </p>
                  <ul class="space-y-0.5">
                    {section.items.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          @click="mobileOpen = false"
                          class="block px-2 py-1.5 text-xs text-slate-300 hover:text-white hover:bg-slate-800/50 rounded transition-colors"
                        >
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )}
        </div>
      ))}

      <div class="pt-3 mt-3">
        <a
          href="/admin/academics/dashboard"
          @click="mobileOpen = false"
          class="flex items-center px-3 py-2.5 text-sm font-medium text-slate-200 hover:text-white hover:bg-slate-800/80 rounded transition-colors"
        >
          <i class="fas fa-lock text-xs mr-2 text-primary-light" aria-hidden="true" />
          Admin Portal
        </a>
      </div>
    </div>
  </div>
</header>

<!-- ============================================================
     Alpine — register searchBar BEFORE Alpine boots.
     Order matters: listener must be attached before `alpine:init` fires.
     ============================================================ -->
<script is:inline>
  document.addEventListener('alpine:init', () => {
    Alpine.data('searchBar', () => ({
      query: '',
      results: [],
      selectedIndex: 0,
      isOpen: false,
      index: null,
      loading: false,

      async loadIndex() {
        if (this.index || this.loading) return;
        this.loading = true;
        try {
          const res = await fetch('/search.json');
          this.index = res.ok ? await res.json() : [];
        } catch {
          this.index = [];
        } finally {
          this.loading = false;
        }
      },

      open() {
        this.loadIndex();
        this.isOpen = true;
      },

      close() {
        this.isOpen = false;
        this.selectedIndex = 0;
      },

      setQuery(q) {
        this.query = q;
        this.performSearch();
        if (this.$refs.searchInput) this.$refs.searchInput.focus();
      },

      performSearch() {
        const q = this.query.trim().toLowerCase();
        if (q.length < 2 || !this.index) {
          this.results = [];
          this.selectedIndex = 0;
          return;
        }
        const words = q.split(/\s+/).filter(Boolean);
        this.results = this.index
          .map((e) => ({ ...e, score: this.score(e, q, words) }))
          .filter((e) => e.score > 0)
          .sort((a, b) => b.score - a.score || a.title.localeCompare(b.title))
          .slice(0, 8);
        this.selectedIndex = 0;
      },

      score(entry, q, words) {
        const title = entry.title.toLowerCase();
        const section = entry.section.toLowerCase();
        const desc = entry.description.toLowerCase();
        const keys = (entry.keywords || []).join(' ').toLowerCase();
        let s = 0;
        if (title === q) s += 200;
        else if (title.startsWith(q)) s += 120;
        else if (title.includes(q)) s += 70;
        if (words.length > 1 && words.every((w) => title.includes(w))) s += 60;
        if (section.includes(q)) s += 40;
        else if (words.some((w) => section.includes(w))) s += 20;
        if (keys.includes(q)) s += 30;
        else if (words.some((w) => keys.includes(w))) s += 15;
        if (desc.includes(q)) s += 15;
        else if (words.every((w) => desc.includes(w))) s += 10;
        return s;
      },

      moveDown() {
        if (this.results.length) this.selectedIndex = (this.selectedIndex + 1) % this.results.length;
      },

      moveUp() {
        if (this.results.length) this.selectedIndex = (this.selectedIndex - 1 + this.results.length) % this.results.length;
      },

      goToSelected() {
        const r = this.results[this.selectedIndex];
        window.location.href = r ? r.href : '/faq';
      },
    }));
  });
</script>

