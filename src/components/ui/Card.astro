---
export interface Props {
  href?: string;
  class?: string;
}
const { href, class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'article';
---

<Tag
  href={href}
  class={`group flex flex-col rounded-2xl border border-slate-200 bg-white
          p-6 sm:p-8 shadow-sm transition-all duration-300
          ${href ? 'hover:-translate-y-1 hover:shadow-xl hover:border-blue-200' : ''}
          ${className}`}>
  <slot />
</Tag>
