---
export interface Props {
  title: string;
  description: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}

const {
  title,
  description,
  primary = { label: 'Get in touch', href: '/contact' },
  secondary,
} = Astro.props;
---

<section
  class='py-20 sm:py-24 px-4 sm:px-6 lg:px-8 bg-white border-t border-slate-100'>
  <div class='max-w-3xl mx-auto text-center'>
    <div class='mx-auto h-px w-16 bg-gold/70 mb-10'></div>
    <h2 class='text-3xl sm:text-4xl font-bold text-secondary text-balance'>
      {title}
    </h2>
    <p class='mt-5 text-base sm:text-lg text-slate-600 leading-relaxed'>
      {description}
    </p>
    <div class='mt-10 flex flex-col sm:flex-row justify-center gap-3 sm:gap-4'>
      <a href={primary.href} class='btn-primary px-6 py-3.5'>
        {primary.label}
        <i class='fas fa-arrow-right text-xs' aria-hidden='true'></i>
      </a>
      {
        secondary && (
          <a href={secondary.href} class='btn-secondary px-6 py-3.5'>
            {secondary.label}
          </a>
        )
      }
    </div>
  </div>
</section>
