---
import type { Pathway } from '../seo/schema/pathway';

interface Props {
  pathway: Pathway;
}
const { pathway } = Astro.props;
---

<article
  class='group relative rounded-2xl border border-slate-200 bg-white shadow-sm
         transition-all duration-300 hover:-translate-y-1 hover:shadow-xl
         overflow-hidden flex flex-col'>
  <a
    href={pathway.href}
    class='absolute inset-0 z-10'
    aria-label={pathway.title}></a>

  <!-- Image + overlay badges -->
  <div class='relative aspect-[16/10] overflow-hidden bg-slate-100'>
    <img
      src={pathway.image.src}
      alt={pathway.image.alt}
      class='w-full h-full object-cover transition-transform duration-500 group-hover:scale-105'
      loading='lazy'
      decoding='async'
    />
    <div
      class='absolute top-4 left-4 h-12 w-12 rounded-xl bg-white/95 backdrop-blur
             text-primary flex items-center justify-center shadow-md'>
      <i class={`fas fa-${pathway.icon} text-xl`} aria-hidden='true'></i>
    </div>
    <span
      class='absolute top-4 right-4 inline-flex items-center gap-1.5 rounded-full
             bg-white/95 backdrop-blur px-3 py-1 text-xs font-semibold text-primary shadow-md'>
      <i class={`fa-regular fa-${pathway.meta.icon}`} aria-hidden='true'></i>
      {pathway.meta.label}
    </span>
  </div>

  <!-- Body -->
  <div class='p-6 flex-1'>
    <h3 class='text-lg font-bold text-secondary'>{pathway.title}</h3>
    <p class='mt-2 text-sm leading-relaxed text-slate-600'>
      {pathway.description}
    </p>
  </div>

  <!-- Hover arrow -->
  <div
    class='px-6 pb-5 pt-0 flex items-center gap-2 text-sm font-semibold text-primary
           opacity-0 group-hover:opacity-100 transition-opacity'>
    Learn more
    <i class='fas fa-arrow-right text-xs' aria-hidden='true'></i>
  </div>
</article>
