---
import type { ResearchArea } from '../../components/seo/schema/researchAreas';
interface Props { area: ResearchArea; }
const { area } = Astro.props;
---

<article
  class="rounded-2xl border border-slate-200 bg-white p-6
         hover:border-blue-300 hover:shadow-md transition-all"
>
  <div
    class="w-12 h-12 rounded-lg bg-blue-100 text-primary flex items-center justify-center mb-4"
  >
    <i class={`fas fa-${area.icon} text-lg`} aria-hidden="true" />
  </div>
  <h3 class="text-base font-bold text-secondary mb-2">{area.title}</h3>
  <p class="text-sm text-slate-600 leading-relaxed">{area.description}</p>
</article>