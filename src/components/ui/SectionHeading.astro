---
export interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  tone?: 'dark' | 'light';
}
const { eyebrow, title, lead, tone = 'dark' } = Astro.props;
---

<div class='max-w-3xl mb-14'>
  {
    eyebrow && (
      <span class={tone === 'light' ? 'eyebrow-light' : 'eyebrow'}>
        {eyebrow}
      </span>
    )
  }
  <h2
    class={`mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-balance ${
      tone === 'light' ? 'text-white' : 'text-secondary'
    }`}>
    {title}
  </h2>
  {
    lead && (
      <p
        class={`mt-5 text-base sm:text-lg leading-relaxed ${
          tone === 'light' ? 'text-slate-300' : 'text-slate-600'
        }`}>
        {lead}
      </p>
    )
  }
</div>
