---
import StudentAttachmentForm from '../forms/StudentAttachmentForm.jsx';
import SectionHeader from '../ui/SectionHeader.astro';
---

<section
  id='student-application'
  class='relative py-20 sm:py-28 px-2 sm:px-4 lg:px-8 bg-white'>
  <div class='relative max-w-4xl mx-auto'>
    <SectionHeader
      eyebrow='Student Application'
      title='Apply Now'
      lead="Secure your clinical attachment. You'll get a tracking code upon submission."
    />

    <div
      class='bg-white rounded-3xl border border-slate-200 shadow-2xl overflow-hidden'>
      <div class='bg-primary px-8 py-6'>
        <h3 class='text-white text-2xl font-bold'>
          Clinical Attachment Application
        </h3>
        <p class='text-blue-100 text-sm mt-1'>
          Complete the form below to start your journey.
        </p>
      </div>
      <div class='p-6 sm:p-10'>
        <StudentAttachmentForm client:load />
      </div>
    </div>
  </div>
</section>
