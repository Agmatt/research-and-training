---
import PartnershipInquiryForm from '../forms/PartnershipInquiryForm.jsx';
import SectionHeader from '../ui/SectionHeader.astro';
---

<section
  id='partnership-inquiry'
  class='relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-100'>
  <div
    class='absolute top-0 left-1/2 -translate-x-1/2 w-full h-px bg-gradient-to-r from-transparent via-primary/50 to-transparent'>
  </div>

  <div class='relative max-w-3xl mx-auto'>
    <SectionHeader
      eyebrow='Partnership Inquiry'
      title="Let's Talk"
      lead="Tell us about your institution and partnership interests. We'll get back to you within 72 hours."
    />

    <div
      class='bg-gradient-to-br from-slate-800 to-slate-900 rounded-3xl border border-slate-700/50 shadow-2xl overflow-hidden'>
      <div class='px-8 py-6'>
        <h3 class='text-white text-2xl font-bold'>
          Institutional Partnership Form
        </h3>
        <p class='text-blue-100 text-sm mt-1'>
          We look forward to collaborating with you.
        </p>
      </div>
      <div class='p-6 sm:p-10'>
        <PartnershipInquiryForm client:load />
      </div>
    </div>
  </div>
</section>
