---
import { SITE } from '../../data/site';
---

<section class='bg-slate-100 py-20 px-4 sm:px-6 lg:px-8'>
  <div class='max-w-3xl mx-auto text-center'>
    <h2
      class='text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-secondary text-balance'>
      Ready to Start Your Journey?
    </h2>
    <p class='mt-4 text-lg max-w-2xl mx-auto text-slate-600'>
      Whether you&rsquo;re a student seeking clinical experience or an
      institution building partnerships, SPMH is ready to collaborate with you.
    </p>

    <div class='mt-10 flex flex-col sm:flex-row justify-center gap-4'>
      <a href='#student-application' class='btn-primary px-8 py-4 text-base'>
        Apply as Student
        <i class='fas fa-arrow-right text-sm' aria-hidden='true'></i>
      </a>
      <a href='#partnerships' class='btn-secondary px-8 py-4 text-base'>
        Start Partnership
      </a>
    </div>

    <p class='mt-8 text-sm text-slate-600'>
      Questions? Check our
      <a
        href={SITE.paths.faq}
        class='text-primary hover:text-primary-dark underline underline-offset-2'>
        frequently asked questions
      </a>
      or
      <a
        href={`mailto:${SITE.emails.academics}`}
        class='text-primary hover:text-primary-dark underline underline-offset-2'>
        contact us directly
      </a>.
    </p>
  </div>
</section>
