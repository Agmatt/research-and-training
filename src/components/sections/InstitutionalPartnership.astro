---
import { SITE } from '../../data/site';

const points = [
  'Structured student attachment pipelines aligned with your curriculum',
  'Joint research initiatives in community and rural health',
  'Faculty exchange and CME program collaboration',
  'Formal international institutional agreements',
];
---

<section
  id='partnerships'
  class='relative bg-slate-900 text-white overflow-hidden'>
  <div
    class='absolute inset-0 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 pointer-events-none'>
  </div>
  <div
    class='absolute -top-40 -right-40 w-80 h-80 bg-blue-500/20 rounded-full blur-3xl pointer-events-none'>
  </div>
  <div
    class='absolute -bottom-40 -left-40 w-80 h-80 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none'>
  </div>

  <div class='relative flex flex-col lg:flex-row items-stretch'>
    <div
      class='w-full lg:w-1/2 px-4 sm:px-6 lg:pl-8 lg:pr-12 py-20 sm:py-28 flex flex-col justify-center'>
      <div class='space-y-8 max-w-xl'>
        <div>
          <span
            class='inline-block bg-blue-500/20 text-primary-light text-xs font-bold
                   uppercase tracking-widest px-4 py-2 rounded-full mb-4'>
            Institutional Collaboration
          </span>
          <h2
            class='text-4xl sm:text-5xl font-bold leading-tight text-white text-balance'>
            Build Sustainable Partnerships
          </h2>
        </div>

        <p class='text-lg text-blue-100/90 leading-relaxed'>
          We&rsquo;re actively expanding our network of academic partners — from
          single placements to standing MOUs covering teaching, research, and
          faculty exchange. Let&rsquo;s discuss what partnership looks like for
          your institution.
        </p>

        <ul class='space-y-4'>
          {
            points.map((p) => (
              <li class='flex items-start gap-3'>
                <span
                  class='h-2 w-2 rounded-full bg-blue-400 shrink-0 mt-2'
                  aria-hidden='true'
                />
                <span class='text-blue-100'>{p}</span>
              </li>
            ))
          }
        </ul>

        <a
          href='#partnership-inquiry'
          class='btn-primary px-6 py-3 inline-flex'>
          Start a Partnership Inquiry
          <i class='fas fa-arrow-right text-xs' aria-hidden='true'></i>
        </a>
      </div>
    </div>

    <div class='w-full lg:w-1/2 relative min-h-[300px] lg:min-h-full'>
      <img
        src='/img/partnership/collaboration.jpg'
        alt='SPMH leadership in a partnership meeting with visiting institutional delegates'
        class='absolute inset-0 w-full h-full object-cover'
        loading='lazy'
        decoding='async'
      />
      <div
        class='absolute inset-0 bg-gradient-to-r from-slate-900/50 to-transparent lg:from-slate-900/20 lg:to-transparent'>
      </div>
    </div>
  </div>
</section>
