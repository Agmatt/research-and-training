---
import {
  researchAreas,
  researchLinkGroups,
} from '../../components/seo/schema/researchAreas';
import ResearchAreaCard from '../ui/ResearchAreaCard.astro';
---

<section
  id='research'
  class='relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-100'>
  <div class='max-w-7xl mx-auto'>
    <!-- Wide banner image with overlay -->
    <div
      class='relative aspect-[21/9] rounded-3xl overflow-hidden mb-16 bg-slate-200 shadow-lg'>
      <img
        src='/img/research/header.jpg'
        alt='SPMH research team at work in the laboratory'
        class='w-full h-full object-cover'
        loading='lazy'
        decoding='async'
      />
      <div
        class='absolute inset-0 bg-gradient-to-t from-slate-900/85 via-slate-900/40 to-transparent'>
      </div>
      <div
        class='absolute bottom-0 left-0 right-0 p-6 sm:p-10 lg:p-12 text-white'>
        <span class='eyebrow-light mb-2'>Research Hub</span>
        <h2 class='text-3xl sm:text-4xl lg:text-5xl font-bold text-white'>
          Research at SPMH
        </h2>
        <p
          class='mt-3 text-sm sm:text-base text-blue-100/90 max-w-2xl leading-relaxed'>
          Collaborative health research across four Key Result Areas, aligned to
          Kenya&rsquo;s Universal Health Coverage agenda, WHO health system
          standards, and Catholic Social Teaching.
        </p>
      </div>
    </div>

    <!-- Four research areas -->
    <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16'>
      {researchAreas.map((area) => <ResearchAreaCard area={area} />)}
    </div>

    <!-- Three link groups -->
    <div class='grid grid-cols-1 lg:grid-cols-3 gap-6'>
      {
        researchLinkGroups.map((group) => (
          <div class='rounded-2xl border border-slate-200 bg-white p-6 shadow-sm'>
            <h3 class='text-sm font-bold uppercase tracking-wider text-slate-500 mb-3'>
              {group.title}
            </h3>
            <ul class='space-y-2 text-sm'>
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    download={link.download ? true : undefined}
                    class={
                      link.cta
                        ? 'text-primary font-semibold hover:underline'
                        : 'text-slate-700 hover:text-primary transition-colors inline-flex items-center gap-1.5'
                    }>
                    {link.download && (
                      <i class='fas fa-download text-xs' aria-hidden='true' />
                    )}
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
